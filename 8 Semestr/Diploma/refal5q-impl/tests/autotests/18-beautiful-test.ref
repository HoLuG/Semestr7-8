* Тест компилируется уже раскрученным компилятором Рефала-5J, что позволяет
* польноваться некоторыми его новыми возможностями. Здесь они тестируются.

$ENTRY Go {
  /* пусто */
    = <Равно ('ПРЕВЕД, МЕДВЕД!') <Upper 'Превед, Медвед!'>>
      <Равно ('превед, медвед!') <Lower 'Превед, Медвед!'>>
      <Равно
        (1055 1088 1077 1074 1077 1076 44 32 1052 1077 1076 1074 1077 1076 33)
        <Ord 'Превед, Медвед!'>
      >
      <Равно ('LuѢ') <Type 'Ѣ'>>
      <Равно ('Llѣ') <Type 'ѣ'>>
      <Равно
        (
          333333333333333333333333333333333333333333333333333333333333333
        )
        <+
          111111111111111111111111111111111111111111111111111111111111111
          222222222222222222222222222222222222222222222222222222222222222
        >
      >
}

Равно { (e.Икс) e.Икс = }
