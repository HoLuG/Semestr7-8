* Тест писался в тот момент, когда компилятор ещё не был раскручен
* и собирался при помощи Рефала-05 или Рефала-5λ, а они Юникод
* не поддерживают. Поэтому исходник не содержит не-ASCII символов.

$ENTRY Go {
  /* пусто */
    = <Eq () <Open 'r' 7 'preved.txt'>>
      <Eq-Preved (<Get 7>) (<Get 7>) (<Get 7>)>
      <Eq () <Close 7>>

      <Eq () <Open r 7 'preved.txt'>>
      <Eq-Preved (<Get 7>) (<Get 7>) (<Get 7>)>
      <Eq () <Close 7>>

      <Eq () <Open rb 7 'preved.txt'>>
      <Eq-Preved-Bin (<Get 7>) (<Get 7>) (<Get 7>)>
      <Eq () <Close 7>>

      <Eq () <Open r 7 'preved-no-eol.txt'>>
      <Eq-Preved-No-EOL (<Get 7>) (<Get 7>)>
      <Eq () <Close 7>>

      <Eq () <Open rb 7 '12-file-functions.REFAL10.bin'>>
      <Eq (<AllBytes> 0) <Get 7> '\n' <Get 7>>
      <Eq () <Close 7>>

      <Eq () <Open 'w' 7 'hello.txt'>>
      <Eq ('hello') <Put 7 'hello'>>
      <Eq () <Putout 7 'hello'>>
      <Eq () <Write 7 'hel'>>
      <Eq () <Write 7 'lo'>>
      <Eq () <Close 7>>

      <Eq () <Open 'r' 7 'hello.txt'>>
      <Eq ('hello') <Get 7>>
      <Eq ('hello') <Get 7>>
      <Eq ('hello' 0) <Get 7>>
      <Eq () <Close 7>>

      <Eq () <Open 'w' 7 'hello.txt'>>
      <Eq () <Putout 7 'hello'>>
      /* неявное закрытие при открытии того же номера */
      <Eq () <Open 'r' 7 'hello.txt'>>
      <Eq ('hello') <Get 7>>
      <Eq (0) <Get 7>>
      /* проверка режима перезаписи */
      <Eq () <Open 'w' 7 'hello.txt'>>
      <Eq () <Putout 7 'hello'>>
      <Eq () <Open 'r' 7 'hello.txt'>>
      <Eq ('hello') <Get 7>>
      <Eq (0) <Get 7>>
      /* проверка режима дозаписи */
      <Eq () <Open 'a' 7 'hello.txt'>>
      <Eq () <Putout 7 'world'>>
      <Eq () <Open 'r' 7 'hello.txt'>>
      <Eq ('hello') <Get 7>>
      /* системное свойство -Dr5jrt.fileLimit=100 */
      <Eq ('world') <Get 107>>
      <Eq (0) <Get 7>>
      <Close 7>

      <Eq (True) <ExistFile 'hello.txt'>>
      <Eq (True ()) <RemoveFile 'hello.txt'>>
      <Eq (False) <ExistFile 'hello.txt'>>

      <NotExist-Ok <RemoveFile 'not-exist.txt'>>

      <Eq () <Open 'r' 7 'preved.txt'>>
      <Eq () <Open 'w' 11 /* имя по умолчанию */>>
      <Eq () <Putout 11 <Get 7> ' ' <Get 7>>>
      <Close 11>
      <Close 7>
      /* Проверка будет осуществлена скриптом тестирования */

      <Eq () <Open wb 10 /* имя по умолчанию */>>
      <Eq () <Write 10 <AllBytes-High>>>
      <Eq () <Close 10>>
      <Eq () <Open ab 10 /* имя по умолчанию */>>
      <Eq () <Write 10 <AllBytes-Low>>>
      <Eq () <Close 10>>
      /* Проверка будет осуществлена скриптом тестирования */

      /* Файл будет открыт неявно */
      <Eq (1 22 333 4444 55555 '!') <Put 12 1 22 333 4444 55555 '!'>>
      <Eq () <Open a 12 /* имя по умолчанию */>>
      <Eq (One Two Three Four '?') <Put 12 One Two Three Four '?'>>
      <Eq () <Putout 12 (((1) (One) ('Hello')) ('"' 100500 '"'))>>
      /* Файл будет закрыт при завершении программы */
}

Eq { (e.X) e.X = }

Eq-Preved {
  (s.P s.r s.e s.v s.e s.d ',')
  (s.M s.e s.d s.v s.e s.d '!')
  (0)
    = /* всё верно */;
}

Eq-Preved-Bin {
  (\xD0\x9F \xD1\x80 \xD0\xB5 \xD0\xB2 \xD0\xB5 \xD0\xB4 ',')
  (\xD0\x9C \xD0\xB5 \xD0\xB4 \xD0\xB2 \xD0\xB5 \xD0\xB4 '!')
  (0)
    = /* всё верно, концы строк UNIX */;

  (\xD0\x9F \xD1\x80 \xD0\xB5 \xD0\xB2 \xD0\xB5 \xD0\xB4 ',' \r)
  (\xD0\x9C \xD0\xB5 \xD0\xB4 \xD0\xB2 \xD0\xB5 \xD0\xB4 '!' \r)
  (0)
    = /* всё верно, концы строк Windows */;
}

Eq-Preved-No-EOL {
  (s.P s.r s.e s.v s.e s.d ',')
  (s.M s.e s.d s.v s.e s.d '!' 0)
    = /* всё верно */;
}

NotExist-Ok {
  False (e.Message)
    = <Prout 'Remove not-existed file, message: "' e.Message '"'>;
}

* В цикле нельзя, на момент написания теста функция Chr ещё не реализована
AllBytes {
  /* пусто */ = <AllBytes-High> <AllBytes-Low>;
}

AllBytes-High {
  /* пусто */
    = \x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0A\x0B\x0C\x0D\x0E\x0F
      \x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1A\x1B\x1C\x1D\x1E\x1F
      \x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2A\x2B\x2C\x2D\x2E\x2F
      \x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3A\x3B\x3C\x3D\x3E\x3F
      \x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4A\x4B\x4C\x4D\x4E\x4F
      \x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5A\x5B\x5C\x5D\x5E\x5F
      \x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6A\x6B\x6C\x6D\x6E\x6F
      \x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7A\x7B\x7C\x7D\x7E\x7F;
}

AllBytes-Low {
  /* пусто */
    = \x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8A\x8B\x8C\x8D\x8E\x8F
      \x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9A\x9B\x9C\x9D\x9E\x9F
      \xA0\xA1\xA2\xA3\xA4\xA5\xA6\xA7\xA8\xA9\xAA\xAB\xAC\xAD\xAE\xAF
      \xB0\xB1\xB2\xB3\xB4\xB5\xB6\xB7\xB8\xB9\xBA\xBB\xBC\xBD\xBE\xBF
      \xC0\xC1\xC2\xC3\xC4\xC5\xC6\xC7\xC8\xC9\xCA\xCB\xCC\xCD\xCE\xCF
      \xD0\xD1\xD2\xD3\xD4\xD5\xD6\xD7\xD8\xD9\xDA\xDB\xDC\xDD\xDE\xDF
      \xE0\xE1\xE2\xE3\xE4\xE5\xE6\xE7\xE8\xE9\xEA\xEB\xEC\xED\xEE\xEF
      \xF0\xF1\xF2\xF3\xF4\xF5\xF6\xF7\xF8\xF9\xFA\xFB\xFC\xFD\xFE\xFF;
}
