$ENTRY Go {
    = <Check <TimeElapsed>> <Calculations> <Check <TimeElapsed>> <Calculations>
      <Check <TimeElapsed 0>> <Calculations> <Check <TimeElapsed>>
      <Calculations> <Check <TimeElapsed>>;
}

Calculations {
    = <Calculations_check
        <Calculations-Aux
          ('aaaaaaaaaaaaaaaz') ('aaaaaaaaaaaaaaaz') ('aaaaaaaaaaaaaaaz')
          ('aaaaaaaaaaaaaaaz') ('aaaaaaaaaaaaaaaz') ('fffffffffffffffz')
        >
      >;
}

Calculations_check {
  'z' = ;
}

Calculations-Aux {
  (e.A-b s.Z e.A-e) (e.B-b s.Z e.B-e) (e.C-b s.Z e.C-e) (e.D-b s.Z e.D-e)
  (e.E-b s.Z e.E-e) (e.F-b s.Z e.F-e)
    = s.Z;
}

Check {
   = <Putout 7 'Empty output with refgo and Linux'>;

  e.Digits1 '.' e.Digits2
    = <Check_check (e.Digits1) (e.Digits2) <IsDigits e.Digits1>>;
}

Check_check {
  (e.Digits1) (e.Digits2) True
    = <Check_check0 (e.Digits1) (e.Digits2) <IsDigits e.Digits2>>;

  e.Other = <Check_cont e.Other>;
}

Check_forward {
  (e.Digits1_fix) t.Digits1_next e.Digits1_rest
    = <Check_next (e.Digits1_fix t.Digits1_next) e.Digits1_rest>;
}

Check_next {
  (e.Digits1_fix) e.Digits1_var '.' e.Digits2
    = <Check_check
        (e.Digits1_fix e.Digits1_var) (e.Digits2)
        <IsDigits e.Digits1_fix e.Digits1_var>
      >;
}

Check_check0 {
  (e.Digits1) (e.Digits2) True
    = <Putout 7 'Time elapsed ' e.Digits1 '.' e.Digits2>;

  (e.Digits1) (e.Digits2) e.Other = <Check_cont (e.Digits1) (e.Digits2) True>;
}

Check_cont {
  (e.Digits1) (e.Digits2) e.Other = <Check_forward (e.Digits1) '.' e.Digits2>;
}

IsDigits {
  e.Digits = <IsDigits0 (e.Digits) <Type e.Digits>>;
}

IsDigits0 {
  (e.Digits) 'D' s.0 s.Digit e.Tail = <IsDigits e.Tail>;

  (e.Digits) '*' s.0 = True;

  (e.Digits) s.Type s.SubType e.Digits1 = False;
}

