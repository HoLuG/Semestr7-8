*$FROM LibraryEx
$EXTERN MapAccum, DelAccumulator, Map, Unique;

$ENTRY Transform {
  e.Units = <Transform-Step UnCondition <Transform-Step UnBlock e.Units>>;
}

Transform-Step {
  s.FnMode e.Units
    = <DelAccumulator
        <MapAccum
          (r5fw-transformer_TransformUnit s.FnMode)
          <MapAccum
            r5fw-transformer_GetFunctionName
            (<Map r5fw-transformer_BuiltinName <ListOfBuiltin>>) e.Units
          >
        >
      >;
}

$ENTRY r5fw-transformer_BuiltinName {
  (s.No s.Name s.Type) = (<Explode s.Name>);
}

$ENTRY r5fw-transformer_GetFunctionName {
  (e.Names) (Function t.SrcPos (e.Name) s.Scope e.Sentences)
    = (e.Names (e.Name)) (Function t.SrcPos (e.Name) s.Scope e.Sentences);

  (e.Names) (Extern e.ExternalNames)
    = (e.Names <Map r5fw-transformer_RemovePos e.ExternalNames>)
      (Extern e.ExternalNames);

  (e.Names) (SpecialComment t.SrcPos e.Text)
    = (e.Names) (SpecialComment t.SrcPos e.Text);
}

$ENTRY r5fw-transformer_RemovePos {
  (t.Pos e.Name) = (e.Name);
}

$ENTRY r5fw-transformer_TransformUnit {
  s.FnMode (e.Names) (Function t.SrcPos (e.Name) s.Scope e.Sentences)
    = <Mu s.FnMode (e.Names) t.SrcPos (e.Name) s.Scope e.Sentences>;

  s.FnMode (e.Names) (Extern e.ExternNames) = (e.Names) (Extern e.ExternNames);

  s.FnMode (e.Names) (SpecialComment t.SrcPos e.Text)
    = (e.Names) (SpecialComment t.SrcPos e.Text);
}

UnBlock {
  (e.Names) t.SrcPos (e.Name) s.Scope e.Sentences
    = <DoUnBlock
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Name) () () e.Sentences ()
      >;
}

DoUnBlock {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) e.Sentences-B (e.BlockedSentence) e.Sentences-E
  (e.UnscannedFunctions)
    = <DoUnBlock_check
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence)
        (e.Sentences-E) (e.UnscannedFunctions) <WithBlock e.BlockedSentence>
      >;

  e.Other = <DoUnBlock_cont e.Other>;
}

DoUnBlock_check {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) (e.SentencePrefix) CALL-BLOCK (e.BlockResult)
  e.SubSentences
    = <DoUnBlock_check0
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence)
        (e.Sentences-E) (e.UnscannedFunctions) (e.SentencePrefix)
        (e.BlockResult) (e.SubSentences) <NewName (e.Names) e.Prefix>
      >;

  e.Other = <DoUnBlock_cont0 e.Other>;
}

DoUnBlock_forward {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B_fix) t.Sentences-B_next
  e.Sentences-B_rest (e.UnscannedFunctions)
    = <DoUnBlock_next
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B_fix t.Sentences-B_next)
        e.Sentences-B_rest (e.UnscannedFunctions)
      >;

  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B_fix) (e.UnscannedFunctions)
    = <DoUnBlock_cont
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) e.Sentences-B_fix (e.UnscannedFunctions)
      >;
}

DoUnBlock_next {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B_fix) e.Sentences-B_var
  (e.BlockedSentence) e.Sentences-E (e.UnscannedFunctions)
    = <DoUnBlock_check
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B_fix e.Sentences-B_var)
        (e.BlockedSentence) (e.Sentences-E) (e.UnscannedFunctions)
        <WithBlock e.BlockedSentence>
      >;

  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B_fix) e.Sentences-B_rest
  (e.UnscannedFunctions)
    = <DoUnBlock_cont
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) e.Sentences-B_fix e.Sentences-B_rest
        (e.UnscannedFunctions)
      >;
}

DoUnBlock_cont {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) e.UnscannedSentences (e.UnscannedFunctions)
    = <DoUnBlock-NextFunction
        (e.Names) t.SrcPos (e.Prefix)
        (
          e.ScannedFunctions
          (
            Function t.SrcPos (e.Name) s.Scope e.ScannedSentences
            e.UnscannedSentences
          )
        )
        (e.UnscannedFunctions)
      >;
}

DoUnBlock_check0 {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) (e.SentencePrefix) (e.BlockResult) (e.SubSentences)
  (e.RefilledNames) e.NewName
    = <DoUnBlock_check1
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence)
        (e.Sentences-E) (e.UnscannedFunctions) (e.SentencePrefix)
        (e.BlockResult) (e.SubSentences) (e.RefilledNames) (e.NewName)
        <BlockScopeVars e.SentencePrefix>
      >;

  e.Other = <DoUnBlock_cont1 e.Other>;
}

DoUnBlock_cont0 {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) e.Other
    = <DoUnBlock_forward
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) e.Sentences-E
        (e.UnscannedFunctions)
      >;
}

DoUnBlock_check1 {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) (e.SentencePrefix) (e.BlockResult) (e.SubSentences)
  (e.RefilledNames) (e.NewName) e.ScopeVars
    = <DoUnBlock
        (e.RefilledNames) t.SrcPos (e.Name) s.Scope (e.Prefix)
        (e.ScannedFunctions)
        (
          e.ScannedSentences e.Sentences-B
          (
            e.SentencePrefix RETURN
            ((Call t.SrcPos (e.NewName) e.ScopeVars e.BlockResult))
          )
        )
        e.Sentences-E
        (
          e.UnscannedFunctions
          (
            (e.NewName)
            <Map (r5fw-transformer_AddScopeVars e.ScopeVars) e.SubSentences>
          )
        )
      >;

  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) (e.SentencePrefix) (e.BlockResult) (e.SubSentences)
  (e.RefilledNames) (e.NewName) e.Other
    = <DoUnBlock_cont1
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence)
        (e.Sentences-E) (e.UnscannedFunctions) (e.SentencePrefix)
        (e.BlockResult) (e.SubSentences) (e.RefilledNames) e.NewName
      >;
}

DoUnBlock_cont1 {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence) (e.Sentences-E)
  (e.UnscannedFunctions) (e.SentencePrefix) (e.BlockResult) (e.SubSentences)
  e.Other
    = <DoUnBlock_cont0
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.ScannedSentences) (e.Sentences-B) (e.BlockedSentence)
        (e.Sentences-E) (e.UnscannedFunctions) (e.SentencePrefix) CALL-BLOCK
        (e.BlockResult) e.SubSentences
      >;
}

DoUnBlock-NextFunction {
  (e.Names) t.SrcPos (e.Prefix) (e.ScannedFunctions)
  (((e.NextFunctionName) e.NextFunctionSentences) e.UnscannedFunctions)
    = <DoUnBlock
        (e.Names) t.SrcPos (e.NextFunctionName) Local (e.Prefix)
        (e.ScannedFunctions) () e.NextFunctionSentences (e.UnscannedFunctions)
      >;

  (e.Names) t.SrcPos (e.Prefix) (e.ScannedFunctions) ()
    = (e.Names) e.ScannedFunctions;
}

WithBlock {
  (e.Pattern) e.Sentence = <DoWithBlock ((e.Pattern)) e.Sentence>;
}

DoWithBlock {
  (e.Prefix) (Condition t.CondResult t.CondPattern) e.Tail
    = <DoWithBlock (e.Prefix (Condition t.CondResult t.CondPattern)) e.Tail>;

  (e.Prefix) CALL-BLOCK t.Result e.SubSentences
    = (e.Prefix) CALL-BLOCK t.Result e.SubSentences;

  (e.Prefix) RETURN t.Result = ;
}

BlockScopeVars {
  (e.Pattern) e.Conditions
    = <Map
        r5fw-transformer_MakeVariables
        <ExtractVariables ((e.Pattern) e.Conditions RETURN ())>
      >;
}

$ENTRY r5fw-transformer_MakeVariables {
  ('e' e.Index) = (Brackets (Variable NO-POS 'e' e.Index));

  (s.VarType e.Index) = (Variable NO-POS s.VarType e.Index);
}

$ENTRY r5fw-transformer_AddScopeVars {
  e.ScopeVars ((e.Pattern) e.Tail) = ((e.ScopeVars e.Pattern) e.Tail);
}

UnCondition {
  (e.Names) t.SrcPos (e.Name) s.Scope e.Sentences
    = <DoUnCondition
        (e.Names) t.SrcPos (e.Name) s.Scope (e.Name) () e.Sentences ()
      >;
}

DoUnCondition {
  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  e.Sentences-B ((e.Pattern) (Condition e.Condition) e.Tail) e.Sentences-E
  (e.UnscannedFunctions)
    = <DoUnCondition-ConditionSentence
        t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
        (e.Sentences-B) (e.UnscannedFunctions)
        <UnConditionSentence
          (e.Names) (e.Prefix) ((e.Pattern) (Condition e.Condition) e.Tail)
          e.Sentences-E
        >
      >;

  (e.Names) t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions)
  e.Sentences (e.UnscannedFunctions)
    = <DoUnCondition-NextFunction
        (e.Names) t.SrcPos (e.Prefix)
        (e.ScannedFunctions (Function t.SrcPos (e.Name) s.Scope e.Sentences))
        (e.UnscannedFunctions)
      >;
}

DoUnCondition-ConditionSentence {
  t.SrcPos (e.Name) s.Scope (e.Prefix) (e.ScannedFunctions) (e.Sentences-B)
  (e.UnscannedFunctions) (e.Names) (e.TransformedSentences) e.NewFunctions
    = <DoUnCondition-NextFunction
        (e.Names) t.SrcPos (e.Prefix)
        (
          e.ScannedFunctions
          (
            Function t.SrcPos (e.Name) s.Scope e.Sentences-B
            e.TransformedSentences
          )
        )
        (e.UnscannedFunctions e.NewFunctions)
      >;
}

DoUnCondition-NextFunction {
  (e.Names) t.SrcPos (e.Prefix) (e.ScannedFunctions)
  (((e.NextFunctionName) e.NextFunctionSentences) e.UnscannedFunctions)
    = <DoUnCondition
        (e.Names) t.SrcPos (e.NextFunctionName) Local (e.Prefix)
        (e.ScannedFunctions) e.NextFunctionSentences (e.UnscannedFunctions)
      >;

  (e.Names) t.SrcPos (e.Prefix) (e.ScannedFunctions) ()
    = (e.Names) e.ScannedFunctions;
}

UnConditionSentence {
  (e.Names) (e.Prefix) (e.Sentence) e.ContinuationSentences
    = <UnConditionSentence-AnalyzeContinuation
        (e.Prefix) (e.Sentence)
        <AnalyzeContinuation (e.Names) (e.Prefix) e.ContinuationSentences>
      >;
}

UnConditionSentence-AnalyzeContinuation {
  (e.Prefix) (e.Sentence) (e.Names) t.ContName e.ContFunction
    = <UnConditionSentence-ConditionSubFunctions
        t.ContName (e.ContFunction)
        <ConditionSubFunctions (e.Names) (e.Prefix) t.ContName e.Sentence>
      >;
}

UnConditionSentence-ConditionSubFunctions {
  t.ContName (e.ContFunction) (e.Names) (e.CallCheckSentence) e.SubFunctions
    = (e.Names)
      (
        (e.CallCheckSentence)
        <MakeContinuationSentence
          t.ContName ((Variable NO-POS 'eOther')) ((Variable NO-POS 'eOther'))
        >
      )
      e.SubFunctions e.ContFunction;
}

AnalyzeContinuation {
  (e.Names) (e.Prefix) = (e.Names) NoContinuation;

  (e.Names) (e.Prefix) e.Sentences
    = <AnalyzeContinuation_check
        (e.Names) (e.Prefix) (e.Sentences) <NewName (e.Names) e.Prefix '_cont'>
      >;
}

AnalyzeContinuation_check {
  (e.Names) (e.Prefix) (e.Sentences) (e.RefilledNames) e.ContName
    = (e.RefilledNames) (e.ContName) ((e.ContName) e.Sentences);
}

MakeContinuationSentence {
  NoContinuation (e.Pattern) (e.ContArg) = ;

  (e.ContName) (e.Pattern) (e.ContArg)
    = ((e.Pattern) RETURN ((Call NO-POS (e.ContName) e.ContArg)));
}

PatternSteps {
  (e.UsedVariables) e.Pattern
    = <DoPatternSteps (e.UsedVariables) () (HOLE e.Pattern)>;
}

DoPatternSteps {
  t.UsedVariables (e.BoundEVariables) e.HolesAndItems
    = <DoPatternSteps0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems
      >;
}

DoPatternSteps0 {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE t.Item e.Pattern) e.HolesAndItems-E
    = <DoPatternSteps0_check
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B) t.Item (e.Pattern) (e.HolesAndItems-E)
        <HardItem (e.BoundEVariables) t.Item>
      >;

  e.Other = <DoPatternSteps0_cont e.Other>;
}

DoPatternSteps0_check {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B)
  t.Item (e.Pattern) (e.HolesAndItems-E) True
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables) e.HolesAndItems-B t.Item
        (HOLE e.Pattern) e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B)
  t.Item (e.Pattern) (e.HolesAndItems-E) e.Other
    = <DoPatternSteps0_forward
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B) (HOLE t.Item e.Pattern) e.HolesAndItems-E
      >;
}

DoPatternSteps0_forward {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  t.HolesAndItems-B_next e.HolesAndItems-B_rest
    = <DoPatternSteps0_next
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B_fix t.HolesAndItems-B_next) e.HolesAndItems-B_rest
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
    = <DoPatternSteps0_cont
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        e.HolesAndItems-B_fix
      >;
}

DoPatternSteps0_next {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  e.HolesAndItems-B_var (HOLE t.Item e.Pattern) e.HolesAndItems-E
    = <DoPatternSteps0_check
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B_fix e.HolesAndItems-B_var) t.Item (e.Pattern)
        (e.HolesAndItems-E) <HardItem (e.BoundEVariables) t.Item>
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  e.HolesAndItems-B_rest
    = <DoPatternSteps0_cont
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        e.HolesAndItems-B_fix e.HolesAndItems-B_rest
      >;
}

DoPatternSteps0_cont {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE e.Pattern t.Item) e.HolesAndItems-E
    = <DoPatternSteps0_check0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B) (e.Pattern) t.Item (e.HolesAndItems-E)
        <HardItem (e.BoundEVariables) t.Item>
      >;

  e.Other = <DoPatternSteps0_cont0 e.Other>;
}

DoPatternSteps0_check0 {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B)
  (e.Pattern) t.Item (e.HolesAndItems-E) True
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables) e.HolesAndItems-B (HOLE e.Pattern)
        t.Item e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B)
  (e.Pattern) t.Item (e.HolesAndItems-E) e.Other
    = <DoPatternSteps0_forward0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B) (HOLE e.Pattern t.Item) e.HolesAndItems-E
      >;
}

DoPatternSteps0_forward0 {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  t.HolesAndItems-B_next e.HolesAndItems-B_rest
    = <DoPatternSteps0_next0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B_fix t.HolesAndItems-B_next) e.HolesAndItems-B_rest
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
    = <DoPatternSteps0_cont0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        e.HolesAndItems-B_fix
      >;
}

DoPatternSteps0_next0 {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  e.HolesAndItems-B_var (HOLE e.Pattern t.Item) e.HolesAndItems-E
    = <DoPatternSteps0_check0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        (e.HolesAndItems-B_fix e.HolesAndItems-B_var) (e.Pattern) t.Item
        (e.HolesAndItems-E) <HardItem (e.BoundEVariables) t.Item>
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) (e.HolesAndItems-B_fix)
  e.HolesAndItems-B_rest
    = <DoPatternSteps0_cont0
        t.UsedVariables (e.BoundEVariables) (e.HolesAndItems)
        e.HolesAndItems-B_fix e.HolesAndItems-B_rest
      >;
}

DoPatternSteps0_cont0 {
  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE (Variable t.SrcPos 'e' e.Index)) e.HolesAndItems-E
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables (e.Index)) e.HolesAndItems-B
        (Variable t.SrcPos 'e' e.Index) e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE) e.HolesAndItems-E
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables) e.HolesAndItems-B e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE (Brackets e.InBrackets) e.Pattern) e.HolesAndItems-E
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables) e.HolesAndItems-B (LeftBracket)
        (HOLE e.InBrackets) (RightBracket) (HOLE e.Pattern) e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE e.Pattern (Brackets e.InBrackets)) e.HolesAndItems-E
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables) e.HolesAndItems-B (HOLE e.Pattern)
        (LeftBracket) (HOLE e.InBrackets) (RightBracket) e.HolesAndItems-E
      >;

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.HolesAndItems-B
  (HOLE (Variable t.SrcPos 'e' e.Index) e.Pattern) e.HolesAndItems-E
    = <DoPatternSteps
        t.UsedVariables (e.BoundEVariables (e.Index)) e.HolesAndItems-B
        (OpenE t.SrcPos 'e' e.Index) (HOLE e.Pattern) e.HolesAndItems-E
      >

      (
        <Map
          r5fw-transformer_BindBrackets <T1 t.UsedVariables e.HolesAndItems>
          <T2 t.UsedVariables e.HolesAndItems>
          <T3 t.UsedVariables e.HolesAndItems>
          <T4 t.UsedVariables e.HolesAndItems>
          <T5 t.UsedVariables e.HolesAndItems>
          <T5-sub t.UsedVariables t.SrcPos e.Index>
          <T6 t.UsedVariables e.HolesAndItems>
          <T7 t.UsedVariables e.HolesAndItems>
        >
      );

  t.UsedVariables (e.BoundEVariables) (e.HolesAndItems) e.OnlyItems
    = (<r5fw-transformer_BindBrackets <T0 e.OnlyItems>>);
}

HardItem {
  (e.BoundEVariables) (Symbol s.Type e.Info) = True;

  (e.BoundEVariables) (Variable t.SrcPos 's' e.Index) = True;

  (e.BoundEVariables) (Variable t.SrcPos 't' e.Index) = True;

  (e.BoundEVariables-B (e.Index) e.BoundEVariables-E)
  (Variable t.SrcPos 'e' e.Index)
    = True;

  (e.BoundEVariables) (Variable t.SrcPos 'e' e.Index) = False;

  (e.BoundEVariables) (Brackets e.Pattern) = False;
}

$ENTRY r5fw-transformer_BindBrackets {
  (e.Expr) = (<DoBindBrackets ('$') e.Expr>);
}

DoBindBrackets {
  (t.MultiBracket e.Scanned) t.Symbol e.Tail
    = <DoBindBrackets_check
        t.MultiBracket (e.Scanned) t.Symbol (e.Tail) t.Symbol
      >;

  e.Other = <DoBindBrackets_cont e.Other>;
}

DoBindBrackets_check {
