Substitute {
  (Variable t.SrcPos1 s.Type e.Index) e.Tail
  ((Variable t.SrcPos2 s.Type e.Index) e.Expr)
    = e.Expr <Substitute e.Tail ((Variable t.SrcPos2 s.Type e.Index) e.Expr)>;

