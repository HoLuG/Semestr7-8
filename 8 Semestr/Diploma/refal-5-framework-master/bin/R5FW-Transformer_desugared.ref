    = <ConditionSubFunctions-CheckFunction_check0
        (e.Names) (e.CheckFunction) (e.Prefix) t.ContName (e.Sentence)
        (e.Pattern) (e.CondResult) (e.CondPattern) (e.SentenceTail)
        (e.SentenceVariables) <BlockScopeVars (e.Pattern)>
      >;
}

ConditionSubFunctions-CheckFunction_check0 {
  (e.Names) (e.CheckFunction) (e.Prefix) t.ContName (e.Sentence) (e.Pattern)
  (e.CondResult) (e.CondPattern) (e.SentenceTail) (e.SentenceVariables)
  e.PatternVarsAsExpr
    = <ConditionSubFunctions-OpenEChain
        (e.CheckFunction) (e.PatternVarsAsExpr) (e.Pattern)
        (Condition (e.CondResult) (e.CondPattern)) (e.SentenceTail)
        <OpenEChain
          (e.Names) (e.SentenceVariables) (e.Prefix) t.ContName
          (e.CheckFunction) (e.PatternVarsAsExpr) (e.CondResult)
          <PatternSteps (e.SentenceVariables) e.Pattern>
        >
      >;
}

ConditionSubFunctions-OpenEChain {
  (e.CheckFunction) (e.PatternVarsAsExpr) (e.Pattern)
  (Condition (e.CondResult) (e.CondPattern)) (e.SentenceTail) (e.Names)
  (e.ContSentence) e.OpenEFunctions
    = (e.Names)
      (
        (e.Pattern) RETURN
        ((Call NO-POS (e.CheckFunction) e.PatternVarsAsExpr e.CondResult))
      )

      (
        (e.CheckFunction) ((e.PatternVarsAsExpr e.CondPattern) e.SentenceTail)
        e.ContSentence
      )
      e.OpenEFunctions;
}

OpenEChain {
  (e.Names) (e.VarNames) (e.Prefix) NoContinuation (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) ((e.T0))
    = (e.Names) ();

  (e.Names) (e.VarNames) (e.Prefix) (e.ContName) (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) ((e.T0))
    = <OpenEChain_check
        (e.Names) (e.VarNames) (e.Prefix) (e.ContName) (e.CheckFunction)
        (e.PatternVarsAsExpr) (e.CondResult) (e.T0)
        <NewName (e.VarNames) 'eOther'>
      >;

  e.Other = <OpenEChain_cont e.Other>;
}

OpenEChain_check {
  (e.Names) (e.VarNames) (e.Prefix) (e.ContName) (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.NewVarNames) e.eOther
    = (e.Names)
      (
        (
          (e.PatternVarsAsExpr (Variable NO-POS e.eOther)) RETURN
          ((Call NO-POS (e.ContName) e.T0))
        )
      );

  (e.Names) (e.VarNames) (e.Prefix) (e.ContName) (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) (e.T0) e.Other
    = <OpenEChain_cont
        (e.Names) (e.VarNames) (e.Prefix) (e.ContName) (e.CheckFunction)
        (e.PatternVarsAsExpr) (e.CondResult) ((e.T0))
      >;
}

OpenEChain_cont {
  (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) ((e.T0)) e.Templates
    = <OpenEChain_check0
        (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
        (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates)
        <NewName (e.Names) e.Prefix '_forward'>
      >;
}

OpenEChain_check0 {
  (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates) (e.NewNames)
  e.NextForward
    = <OpenEChain_check1
        (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
        (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates) (e.NewNames)
        (e.NextForward)
        <DoOpenEChain
          (e.NextForward) (e.NewNames) (e.Prefix) t.ContName (e.CheckFunction)
          (e.PatternVarsAsExpr e.CondResult) () e.Templates
        >
      >;
}

OpenEChain_check1 {
  (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates) (e.NewNames)
  (e.NextForward) (e.RefilledNames) e.NewFunctions
    = <OpenEChain_check2
        (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
        (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates) (e.NewNames)
        (e.NextForward) (e.RefilledNames) (e.NewFunctions)
        <NewName (e.VarNames) 'eOther'>
      >;
}

OpenEChain_check2 {
  (e.Names) (e.VarNames) (e.Prefix) t.ContName (e.CheckFunction)
  (e.PatternVarsAsExpr) (e.CondResult) (e.T0) (e.Templates) (e.NewNames)
  (e.NextForward) (e.RefilledNames) (e.NewFunctions) (e.NewVarNames) e.eOther
    = (e.RefilledNames)
      (
        (
          (e.PatternVarsAsExpr (Variable NO-POS e.eOther)) RETURN
          ((Call NO-POS (e.NextForward) e.T0))
        )
      )
      e.NewFunctions;
}

DoOpenEChain {
  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet)
    = <DoOpenEChain_check
        (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
        (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet)
        <MakeOpenE-ForwardNext
          (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
          (e.CheckFunctionArg) e.TemplateSet
        >
      >;

  e.Other = <DoOpenEChain_cont e.Other>;
}

DoOpenEChain_check {
  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet) (e.RefilledNames)
  e.NewFunctions
    = (e.RefilledNames) e.GeneratedFunctions e.NewFunctions;

  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet) e.Other
    = <DoOpenEChain_cont
        (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
        (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet)
      >;
}

DoOpenEChain_cont {
  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet) e.TemplateSets
    = <DoOpenEChain_check0
        (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
        (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet)
        (e.TemplateSets) <NewName (e.Names) e.Prefix '_forward'>
      >;
}

DoOpenEChain_check0 {
  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet) (e.TemplateSets)
  (e.Names1) e.NextForward
    = <DoOpenEChain_check1
        (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
        (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet)
        (e.TemplateSets) (e.Names1) (e.NextForward)
        <MakeOpenE-ForwardNext
          (e.CurrentForward) (e.Names1) (e.Prefix) (e.NextForward)
          (e.CheckFunction) (e.CheckFunctionArg) e.TemplateSet
        >
      >;
}

DoOpenEChain_check1 {
  (e.CurrentForward) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.GeneratedFunctions) (e.TemplateSet) (e.TemplateSets)
  (e.Names1) (e.NextForward) (e.RefilledNames) e.NewFunctions
    = <DoOpenEChain
        (e.NextForward) (e.RefilledNames) (e.Prefix) t.ContName
        (e.CheckFunction) (e.CheckFunctionArg)
        (e.GeneratedFunctions e.NewFunctions) e.TemplateSets
      >;
}

MakeOpenE-ForwardNext {
  (e.CurrentForwardName) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.T1) (e.T2) (e.T3) (e.T4) (e.T5) (e.T5-sub) (e.T6)
  (e.T7)
    = <MakeOpenE-ForwardNext_check
        (e.CurrentForwardName) (e.Names) (e.Prefix) t.ContName
        (e.CheckFunction) (e.CheckFunctionArg) (e.T1) (e.T2) (e.T3) (e.T4)
        (e.T5) (e.T5-sub) (e.T6) (e.T7) <NewName (e.Names) e.Prefix '_next'>
      >;
}

MakeOpenE-ForwardNext_check {
  (e.CurrentForwardName) (e.Names) (e.Prefix) t.ContName (e.CheckFunction)
  (e.CheckFunctionArg) (e.T1) (e.T2) (e.T3) (e.T4) (e.T5) (e.T5-sub) (e.T6)
  (e.T7) (e.RefilledNames) e.NextName
    = (e.RefilledNames)
      (
        (e.CurrentForwardName)
        ((e.T1) RETURN ((Call NO-POS (e.NextName) e.T2)))
        <MakeContinuationSentence t.ContName (e.T3) (e.T4)>
      )

      (
        (e.NextName)
        (
          (e.T5) RETURN
          (
            (
              Call NO-POS (e.CheckFunction)
              <Substitute e.CheckFunctionArg (e.T5-sub)>
            )
          )
        )
        <MakeContinuationSentence t.ContName (e.T6) (e.T7)>
      );
}

ExtractVariables {
  e.Sentences = <Unique <ExtractVariables-Sentences e.Sentences>>;
}

ExtractVariables-Sentences {
  ((e.Pattern) e.Tail) e.Sentences
    = <ExtractVariables-Expr e.Pattern> <ExtractVariables-Tail e.Tail>
      <ExtractVariables-Sentences e.Sentences>;

   = ;
}

ExtractVariables-Tail {
  (Condition (e.Result) (e.Pattern)) e.Tail
    = <ExtractVariables-Expr e.Result> <ExtractVariables-Expr e.Pattern>
      <ExtractVariables-Tail e.Tail>;

  RETURN (e.Result) = <ExtractVariables-Expr e.Result>;

  CALL-BLOCK (e.Result) e.Sentences
    = <ExtractVariables-Expr e.Result> <ExtractVariables-Sentences e.Sentences>;
}

ExtractVariables-Expr {
  (Variable t.SrcPos s.VarType e.Index) e.Terms
    = (s.VarType e.Index) <ExtractVariables-Expr e.Terms>;

  (Brackets e.Inner) e.Terms = <ExtractVariables-Expr e.Inner e.Terms>;

  (Call t.SrcPos (e.Function) e.Inner) e.Terms
    = <ExtractVariables-Expr e.Inner e.Terms>;

  t.Other e.Terms = <ExtractVariables-Expr e.Terms>;

   = ;
}

NewName {
  (e.Names-B (e.Prefix) e.Names-E) e.Prefix
    = <DoNewName ((e.Prefix) e.Names-B e.Names-E) e.Prefix 0>;

  (e.Names) e.Prefix = ((e.Prefix) e.Names) e.Prefix;
}

DoNewName {
  (e.Names) e.Prefix s.SufNo
    = <DoNewName-NameGenerated
        (e.Prefix) s.SufNo (e.Prefix <Symb s.SufNo>) e.Names
      >;
}

DoNewName-NameGenerated {
  (e.Prefix) s.SufNo (e.NewName) e.Names-B (e.NewName) e.Names-E
    = <DoNewName ((e.NewName) e.Names-B e.Names-E) e.Prefix <+ s.SufNo 1>>;

  (e.Prefix) s.SufNo (e.NewName) e.Names = ((e.NewName) e.Names) e.NewName;
}

