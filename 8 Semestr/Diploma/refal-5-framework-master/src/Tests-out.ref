$ENTRY RunTests {
    = <Perform
        TestAllSubstrings TestAllSubstrings-Hard TestDocument
        TestSimpleCondition TestSimpleRepeatedCondition TestSimpleOneELoop
      >;
}

$EXTERN Br, Dg;

Perform {
  s.NextTest e.Tests
    = <Prout '* Run test ' s.NextTest> <Mu s.NextTest> <Perform e.Tests>;

   = ;
}

AssertEq {
  e.Equals (e.Equals) = ;
}

*$*****************************************************************************
TestAllSubstrings {
    = <AssertEq
        <AllSubstrings 'abcdef'>
        (
          () ('a') ('ab') ('abc') ('abcd') ('abcde') ('abcdef') () ('b') ('bc')
          ('bcd') ('bcde') ('bcdef') () ('c') ('cd') ('cde') ('cdef') () ('d')
          ('de') ('def') () ('e') ('ef') () ('f') ()
        )
      >;
}

AllSubstrings {
  e.String = <AllSubstrings_check (e.String) <Br Substr '='>>;

  e.Other = <AllSubstrings_cont e.Other>;
}

AllSubstrings_check {
  (e.String) NotEmpty = ;

  (e.String) e.Other = <AllSubstrings_cont e.String>;
}

AllSubstrings_cont {
  e.Begin e.Middle e.End
    = <AllSubstrings_check0
        (e.Begin) (e.Middle) (e.End) <Br Substr '=' <Dg Substr> (e.Middle)>
      >;

  e.Other = <AllSubstrings_cont0 e.Other>;
}

AllSubstrings_check0 {
  (e.Begin) (e.Middle) (e.End) NotEmpty = ;

  (e.Begin) (e.Middle) (e.End) e.Other
    = <AllSubstrings_forward (e.Begin) (e.Middle) e.End>;
}

AllSubstrings_forward {
  (e.Begin) (e.Middle_fix) t.Middle_next e.Middle_rest
    = <AllSubstrings_next (e.Begin) (e.Middle_fix t.Middle_next) e.Middle_rest>;

  (e.Begin) (e.Middle_fix) = <AllSubstrings_forward0 (e.Begin) e.Middle_fix>;
}

AllSubstrings_next {
  (e.Begin) (e.Middle_fix) e.Middle_var e.End
    = <AllSubstrings_check0
        (e.Begin) (e.Middle_fix e.Middle_var) (e.End)
        <Br Substr '=' <Dg Substr> (e.Middle_fix e.Middle_var)>
      >;

  (e.Begin) (e.Middle_fix) e.Middle_rest
    = <AllSubstrings_forward0 (e.Begin) e.Middle_fix e.Middle_rest>;
}

AllSubstrings_forward0 {
  (e.Begin_fix) t.Begin_next e.Begin_rest
    = <AllSubstrings_next0 (e.Begin_fix t.Begin_next) e.Begin_rest>;

  (e.Begin_fix) = <AllSubstrings_cont0 e.Begin_fix>;
}

AllSubstrings_next0 {
  (e.Begin_fix) e.Begin_var e.Middle e.End
    = <AllSubstrings_check0
        (e.Begin_fix e.Begin_var) (e.Middle) (e.End)
        <Br Substr '=' <Dg Substr> (e.Middle)>
      >;

  (e.Begin_fix) e.Begin_rest = <AllSubstrings_cont0 e.Begin_fix e.Begin_rest>;
}

AllSubstrings_cont0 {
  e.String = <Dg Substr>;
}

*$*****************************************************************************
TestAllSubstrings-Hard {
    = <AssertEq
        <AllSubstrings-Hard 'abcdef'>
        (
          ('a') ('ab') ('abc') ('abcd') ('abcde') ('abcdef') ('b') ('bc')
          ('bcd') ('bcde') ('bcdef') ('c') ('cd') ('cde') ('cdef') ('d') ('de')
          ('def') ('e') ('ef') ('f')
        )
      >;
}

AllSubstrings-Hard {
  e.String = <AllSubstrings-Hard_check (e.String) <Br Substr '='>>;

  e.Other = <AllSubstrings-Hard_cont e.Other>;
}

AllSubstrings-Hard_check {
  (e.String) NotEmpty = ;

  (e.String) e.Other = <AllSubstrings-Hard_cont e.String>;
}

AllSubstrings-Hard_cont {
  e.Begin e.Middle e.End
    = <AllSubstrings-Hard_check0 (e.Begin) (e.Middle) (e.End) e.Middle>;
}

AllSubstrings-Hard_check0 {
  (e.Begin) (e.Middle) (e.End) t.1 e.2
    = <AllSubstrings-Hard_check1
        (e.Begin) (e.Middle) (e.End) t.1 (e.2)
        <Br Substr '=' <Dg Substr> (e.Middle)>
      >;

  e.Other = <AllSubstrings-Hard_cont0 e.Other>;
}

AllSubstrings-Hard_forward {
  (e.Begin) (e.Middle_fix) t.Middle_next e.Middle_rest
    = <AllSubstrings-Hard_next
        (e.Begin) (e.Middle_fix t.Middle_next) e.Middle_rest
      >;

  (e.Begin) (e.Middle_fix)
    = <AllSubstrings-Hard_forward0 (e.Begin) e.Middle_fix>;
}

AllSubstrings-Hard_next {
  (e.Begin) (e.Middle_fix) e.Middle_var e.End
    = <AllSubstrings-Hard_check0
        (e.Begin) (e.Middle_fix e.Middle_var) (e.End) e.Middle_fix e.Middle_var
      >;

  (e.Begin) (e.Middle_fix) e.Middle_rest
    = <AllSubstrings-Hard_forward0 (e.Begin) e.Middle_fix e.Middle_rest>;
}

AllSubstrings-Hard_forward0 {
  (e.Begin_fix) t.Begin_next e.Begin_rest
    = <AllSubstrings-Hard_next0 (e.Begin_fix t.Begin_next) e.Begin_rest>;
}

AllSubstrings-Hard_next0 {
  (e.Begin_fix) e.Begin_var e.Middle e.End
    = <AllSubstrings-Hard_check0
        (e.Begin_fix e.Begin_var) (e.Middle) (e.End) e.Middle
      >;
}

AllSubstrings-Hard_check1 {
  (e.Begin) (e.Middle) (e.End) t.1 (e.2)
    = <AllSubstrings-Hard_check2
        (e.Begin) (e.Middle) (e.End) t.1 (e.2) e.Middle
      >;

  e.Other = <AllSubstrings-Hard_cont1 e.Other>;
}

AllSubstrings-Hard_cont0 {
  (e.Begin) (e.Middle) (e.End) e.Other
    = <AllSubstrings-Hard_forward (e.Begin) (e.Middle) e.End>;
}

AllSubstrings-Hard_check2 {
  (e.Begin) (e.Middle) (e.End) t.1 (e.2) t.3
    = <AllSubstrings-Hard_check3
        (e.Begin) (e.Middle) (e.End) t.1 (e.2) t.3 e.End
      >;

  e.Other = <AllSubstrings-Hard_cont2 e.Other>;
}

AllSubstrings-Hard_cont1 {
  (e.Begin) (e.Middle) (e.End) t.1 (e.2) e.Other
    = <AllSubstrings-Hard_cont0 (e.Begin) (e.Middle) (e.End) t.1 e.2>;
}

AllSubstrings-Hard_check3 {
  (e.Begin) (e.Middle) (e.End) t.1 (e.2) t.3 = <Dg Substr>;

  (e.Begin) (e.Middle) (e.End) t.1 (e.2) t.3 e.Other
    = <AllSubstrings-Hard_cont2 (e.Begin) (e.Middle) (e.End) t.1 (e.2) t.3>;
}

AllSubstrings-Hard_cont2 {
  (e.Begin) (e.Middle) (e.End) t.1 (e.2) e.Other
    = <AllSubstrings-Hard_cont1 (e.Begin) (e.Middle) (e.End) t.1 (e.2)>;
}

*$*****************************************************************************
TestDocument {
    = <AssertEq
        <F-doc (A (B (A B) C) Q (D (A (B (A B) C) Q D) ED) R) (A A B A A B F)>
        (Ok (A (B (A B) C) Q) (D) (A A B))
      >
      <AssertEq <F-doc (A (B (A B) C) D) (E E F)> (Fail)>;
}

F-doc {
  (e.A (e.B (e.A e.B) e.C) e.D) (e.E e.E e.F)
    = <F-doc_check
        (e.A) (e.B) (e.C) (e.D) (e.E) (e.F) <G-doc (e.A) (e.B) (e.E)>
      >;

  e.Other = <F-doc_cont e.Other>;
}

F-doc_check {
  (e.A) (e.B) (e.C) (e.D) (e.E) (e.F) Ok = Ok (e.A) (e.B) (e.E);

  (e.A) (e.B) (e.C) (e.D) (e.E) (e.F) e.Other
    = <F-doc_forward ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E) e.E e.F)>;
}

F-doc_forward {
  ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E_fix) t.E_next e.E_rest)
    = <F-doc_next
        ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E_fix t.E_next) e.E_rest)
      >;

  ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E_fix))
    = <F-doc_forward0 ((e.A) ((e.B) (e.A e.B) e.C) e.D) (e.E_fix)>;
}

F-doc_next {
  ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E_fix) e.E_var e.E_fix e.E_var e.F)
    = <F-doc_check
        (e.A) (e.B) (e.C) (e.D) (e.E_fix e.E_var) (e.F)
        <G-doc (e.A) (e.B) (e.E_fix e.E_var)>
      >;

  ((e.A) ((e.B) (e.A e.B) e.C) e.D) ((e.E_fix) e.E_rest)
    = <F-doc_forward0 ((e.A) ((e.B) (e.A e.B) e.C) e.D) (e.E_fix e.E_rest)>;
}

F-doc_forward0 {
  ((e.A) ((e.B_fix) t.B_next e.B_rest) e.D) (e.E_rest)
    = <F-doc_next0 ((e.A) ((e.B_fix t.B_next) e.B_rest) e.D) (e.E_rest)>;

  ((e.A) ((e.B_fix)) e.D) (e.E_rest)
    = <F-doc_forward1 ((e.A) (e.B_fix) e.D) (e.E_rest)>;
}

F-doc_next0 {
  ((e.A) ((e.B_fix) e.B_var (e.A e.B_fix e.B_var) e.C) e.D) (e.E e.E e.F)
    = <F-doc_check
        (e.A) (e.B_fix e.B_var) (e.C) (e.D) (e.E) (e.F)
        <G-doc (e.A) (e.B_fix e.B_var) (e.E)>
      >;

  ((e.A) ((e.B_fix) e.B_rest) e.D) (e.E_rest)
    = <F-doc_forward1 ((e.A) (e.B_fix e.B_rest) e.D) (e.E_rest)>;
}

F-doc_forward1 {
  ((e.A_fix) t.A_next e.A_rest) (e.E_rest)
    = <F-doc_next1 ((e.A_fix t.A_next) e.A_rest) (e.E_rest)>;

  ((e.A_fix)) (e.E_rest) = <F-doc_cont (e.A_fix) (e.E_rest)>;
}

F-doc_next1 {
  ((e.A_fix) e.A_var (e.B (e.A_fix e.A_var e.B) e.C) e.D) (e.E e.E e.F)
    = <F-doc_check
        (e.A_fix e.A_var) (e.B) (e.C) (e.D) (e.E) (e.F)
        <G-doc (e.A_fix e.A_var) (e.B) (e.E)>
      >;

  ((e.A_fix) e.A_rest) (e.E_rest) = <F-doc_cont (e.A_fix e.A_rest) (e.E_rest)>;
}

F-doc_cont {
  e.Other = Fail;
}

G-doc {
  (e.A) (D) (A A B) = Ok;

  e.Other = Fail;
}

*$*****************************************************************************
SimpleCondition {
  (e.X) e.Y = <SimpleCondition_check (e.X) (e.Y) e.Y>;

  e.Other = <SimpleCondition_cont e.Other>;
}

SimpleCondition_check {
  (e.X) (e.Y) e.X = Equals e.X;

  (e.X) (e.Y) e.Other = <SimpleCondition_cont (e.X) e.Y>;
}

SimpleCondition_cont {
  (e.X) e.Y = NotEquals (e.X) e.Y;

  e.Other = FORMAT e.Other;
}

SimpleCondition-Edge {
  (e.X) e.Y = <SimpleCondition-Edge_check (e.X) (e.Y) e.Y>;
}

SimpleCondition-Edge_check {
  (e.X) (e.Y) e.X = Equals e.X;
}

TestSimpleCondition {
    = <AssertEq <SimpleCondition ('ABC') 'ABC'> (Equals 'ABC')>
      <AssertEq <SimpleCondition ()> (Equals)>
      <AssertEq <SimpleCondition ('AAA') 'BBB'> (NotEquals ('AAA') 'BBB')>
      <AssertEq <SimpleCondition 'fail'> (FORMAT 'fail')>
      <AssertEq <SimpleCondition-Edge ('ABC') 'ABC'> (Equals 'ABC')>;
}

*$*****************************************************************************
SimpleRepeatedCondition {
  (e.X) e.X e.Y = <SimpleRepeatedCondition_check (e.X) (e.Y) e.X>;

  e.Other = <SimpleRepeatedCondition_cont e.Other>;
}

SimpleRepeatedCondition_check {
  (e.X) (e.Y) e.Y = <SimpleRepeatedCondition0 (e.X) (e.Y) X>;

  (e.X) (e.Y) e.Other = <SimpleRepeatedCondition_cont (e.X) e.X e.Y>;
}

SimpleRepeatedCondition_cont {
  e.Other = FORMAT e.Other;
}

SimpleRepeatedCondition0 {
  (e.X) (e.Y) X = Equals e.X e.Y e.X e.Y;

  (e.X) (e.Y) Y = <SimpleRepeatedCondition0_check (e.X) (e.Y) e.X>;
}

SimpleRepeatedCondition0_check {
  (e.X) (e.Y) e.Z = <SimpleRepeatedCondition0_check0 (e.X) (e.Y) (e.Z) e.Y>;
}

SimpleRepeatedCondition0_check0 {
  (e.X) (e.Y) (e.Z) e.X
    = <Prout e.X e.Y e.X e.X e.Y 'копирований быть не должно'>;
}

SimpleRepeatedCondition-Edge {
  (e.X) e.X e.Y = <SimpleRepeatedCondition-Edge_check (e.X) (e.Y) e.X>;
}

SimpleRepeatedCondition-Edge_check {
  (e.X) (e.Y) e.Y = Equals e.X e.Y e.X e.Y;
}

TestSimpleRepeatedCondition {
    = <AssertEq
        <SimpleRepeatedCondition ('ABC') 'ABCABC'> (Equals 'ABCABCABCABC')
      >
      <AssertEq <SimpleRepeatedCondition ()> (Equals)>
      <AssertEq <SimpleRepeatedCondition 'other'> (FORMAT 'other')>
      <AssertEq
        <SimpleRepeatedCondition-Edge ('ABC') 'ABCABC'> (Equals 'ABCABCABCABC')
      >;
}

*$*****************************************************************************
SimpleOneELoop {
  (e.Sample) e.Items-B ((e.Key) (e.Value)) e.Items-E
    = <SimpleOneELoop_check
        (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Key
      >;

  e.Other = <SimpleOneELoop_cont e.Other>;
}

SimpleOneELoop_check {
  (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Sample
    = (e.Items-B) (e.Value) (e.Items-E);

  (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Other
    = <SimpleOneELoop_forward
        (e.Sample) (e.Items-B) ((e.Key) (e.Value)) e.Items-E
      >;
}

SimpleOneELoop_forward {
  (e.Sample) (e.Items-B_fix) t.Items-B_next e.Items-B_rest
    = <SimpleOneELoop_next
        (e.Sample) (e.Items-B_fix t.Items-B_next) e.Items-B_rest
      >;

  (e.Sample) (e.Items-B_fix) = <SimpleOneELoop_cont (e.Sample) e.Items-B_fix>;
}

SimpleOneELoop_next {
  (e.Sample) (e.Items-B_fix) e.Items-B_var ((e.Key) (e.Value)) e.Items-E
    = <SimpleOneELoop_check
        (e.Sample) (e.Items-B_fix e.Items-B_var) (e.Key) (e.Value) (e.Items-E)
        e.Key
      >;

  (e.Sample) (e.Items-B_fix) e.Items-B_rest
    = <SimpleOneELoop_cont (e.Sample) e.Items-B_fix e.Items-B_rest>;
}

SimpleOneELoop_cont {
  (e.Sample) e.Items = (e.Items);
}

SimpleOneELoop-Edge {
  (e.Sample) e.Items-B ((e.Key) (e.Value)) e.Items-E
    = <SimpleOneELoop-Edge_check
        (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Key
      >;
}

SimpleOneELoop-Edge_check {
  (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Sample
    = (e.Items-B) (e.Value) (e.Items-E);

  (e.Sample) (e.Items-B) (e.Key) (e.Value) (e.Items-E) e.Other
    = <SimpleOneELoop-Edge_forward
        (e.Sample) (e.Items-B) ((e.Key) (e.Value)) e.Items-E
      >;
}

SimpleOneELoop-Edge_forward {
  (e.Sample) (e.Items-B_fix) t.Items-B_next e.Items-B_rest
    = <SimpleOneELoop-Edge_next
        (e.Sample) (e.Items-B_fix t.Items-B_next) e.Items-B_rest
      >;
}

SimpleOneELoop-Edge_next {
  (e.Sample) (e.Items-B_fix) e.Items-B_var ((e.Key) (e.Value)) e.Items-E
    = <SimpleOneELoop-Edge_check
        (e.Sample) (e.Items-B_fix e.Items-B_var) (e.Key) (e.Value) (e.Items-E)
        e.Key
      >;
}

TestSimpleOneELoop {
    = <AssertEq
        <SimpleOneELoop
          ('ABC') X 100 (('XXX') ('YYY')) 'AAAAA' (('ABC') ('DEF')) () () ()
        >
        ((X 100 (('XXX') ('YYY')) 'AAAAA') ('DEF') (() () ()))
      >

      <AssertEq
        <SimpleOneELoop
          ('ABD') X 100 (('XXX') ('YYY')) 'AAAAA' (('ABC') ('DEF')) () () ()
        >
        ((X 100 (('XXX') ('YYY')) 'AAAAA' (('ABC') ('DEF')) () () ()))
      >

      <AssertEq
        <SimpleOneELoop-Edge
          ('ABC') X 100 (('XXX') ('YYY')) 'AAAAA' (('ABC') ('DEF')) () () ()
        >
        ((X 100 (('XXX') ('YYY')) 'AAAAA') ('DEF') (() () ()))
      >;
}

*$*****************************************************************************
Intersect {
  (e.B1 s.1 e.E1) (e.B2 s.2 e.E2)
    = <Intersect_check (e.B1) s.1 (e.E1) (e.B2) s.2 (e.E2) <Eq s.1 s.2>>;

  e.Other = <Intersect_cont e.Other>;
}

Intersect_check {
  (e.B1) s.1 (e.E1) (e.B2) s.2 (e.E2) True
    = s.1 <Intersect (e.E1) (e.B2 e.E2)>;

  (e.B1) s.1 (e.E1) (e.B2) s.2 (e.E2) e.Other
    = <Intersect_forward ((e.B1) s.1 e.E1) ((e.B2) s.2 e.E2)>;
}

Intersect_forward {
  ((e.B1) s.1 e.E1) ((e.B2_fix) t.B2_next e.B2_rest)
    = <Intersect_next ((e.B1) s.1 e.E1) ((e.B2_fix t.B2_next) e.B2_rest)>;

  ((e.B1) s.1 e.E1) ((e.B2_fix))
    = <Intersect_forward0 ((e.B1) s.1 e.E1) (e.B2_fix)>;
}

Intersect_next {
  ((e.B1) s.1 e.E1) ((e.B2_fix) e.B2_var s.2 e.E2)
    = <Intersect_check
        (e.B1) s.1 (e.E1) (e.B2_fix e.B2_var) s.2 (e.E2) <Eq s.1 s.2>
      >;

  ((e.B1) s.1 e.E1) ((e.B2_fix) e.B2_rest)
    = <Intersect_forward0 ((e.B1) s.1 e.E1) (e.B2_fix e.B2_rest)>;
}

Intersect_forward0 {
  ((e.B1_fix) t.B1_next e.B1_rest) (e.B2_rest)
    = <Intersect_next0 ((e.B1_fix t.B1_next) e.B1_rest) (e.B2_rest)>;

  ((e.B1_fix)) (e.B2_rest) = <Intersect_cont (e.B1_fix) (e.B2_rest)>;
}

Intersect_next0 {
  ((e.B1_fix) e.B1_var s.1 e.E1) (e.B2 s.2 e.E2)
    = <Intersect_check
        (e.B1_fix e.B1_var) s.1 (e.E1) (e.B2) s.2 (e.E2) <Eq s.1 s.2>
      >;

  ((e.B1_fix) e.B1_rest) (e.B2_rest)
    = <Intersect_cont (e.B1_fix e.B1_rest) (e.B2_rest)>;
}

Intersect_cont {
  (e.1) (e.2) = ;
}

Eq {
  t.X t.X = True;

  t.X t.Y = False;
}

$ENTRY tests_USE1 {
   = Delim Delim2 FindXY NonsenceFunc RepeatedNonsence;
}

$ENTRY tests_USE2 {
   = KeyValue KeyValueRep Intersect;
}

Delim {
  e.Prefix t.Delim e.Suffix
    = <Delim_check (e.Prefix) t.Delim (e.Suffix) <DelimTerm t.Delim>>;

  e.Other = <Delim_cont e.Other>;
}

Delim_check {
  (e.Prefix) t.Delim (e.Suffix) True = (e.Prefix) e.Suffix;

  (e.Prefix) t.Delim (e.Suffix) e.Other
    = <Delim_forward (e.Prefix) t.Delim e.Suffix>;
}

Delim_forward {
  (e.Prefix_fix) t.Prefix_next e.Prefix_rest
    = <Delim_next (e.Prefix_fix t.Prefix_next) e.Prefix_rest>;

  (e.Prefix_fix) = <Delim_cont e.Prefix_fix>;
}

Delim_next {
  (e.Prefix_fix) e.Prefix_var t.Delim e.Suffix
    = <Delim_check
        (e.Prefix_fix e.Prefix_var) t.Delim (e.Suffix) <DelimTerm t.Delim>
      >;

  (e.Prefix_fix) e.Prefix_rest = <Delim_cont e.Prefix_fix e.Prefix_rest>;
}

Delim_cont {
  e.NoDelim = NoDelim;
}

DelimTerm {
  '|' = True;

  t.Other = False;
}

Delim2 {
  e.Prefix e.Prefix t.Delim e.Suffix
    = <Delim2_check (e.Prefix) t.Delim (e.Suffix) <DelimTerm t.Delim>>;

  e.Other = <Delim2_cont e.Other>;
}

Delim2_check {
  (e.Prefix) t.Delim (e.Suffix) True = <F e.Prefix> <G e.Prefix>;

  (e.Prefix) t.Delim (e.Suffix) e.Other
    = <Delim2_forward (e.Prefix) e.Prefix t.Delim e.Suffix>;
}

Delim2_forward {
  (e.Prefix_fix) t.Prefix_next e.Prefix_rest
    = <Delim2_next (e.Prefix_fix t.Prefix_next) e.Prefix_rest>;

  (e.Prefix_fix) = <Delim2_cont e.Prefix_fix>;
}

Delim2_next {
  (e.Prefix_fix) e.Prefix_var e.Prefix_fix e.Prefix_var t.Delim e.Suffix
    = <Delim2_check
        (e.Prefix_fix e.Prefix_var) t.Delim (e.Suffix) <DelimTerm t.Delim>
      >;

  (e.Prefix_fix) e.Prefix_rest = <Delim2_cont e.Prefix_fix e.Prefix_rest>;
}

Delim2_cont {
  e.Other = Fail;
}

F {
  e.X = ;
}

G {
  e.X = ;
}

FindXY {
  (e.XB (e.XX) e.XE) e.YB (e.YY) e.YE
    = <FindXY_check
        (e.XB) (e.XX) (e.XE) (e.YB) (e.YY) (e.YE) <CheckX e.XX (e.YY)>
      >;

  e.Other = <FindXY_cont e.Other>;
