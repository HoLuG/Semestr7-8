\begin{MintedVerbatim}[commandchars=\\\{\}]
NSTUD      EQU 60
DAYCAP     EQU 20
MAXDAY     EQU 6

SIMULATE

INIT        GENERATE 0,0,0,1
            SAVEVALUE PASSED,0
            SAVEVALUE DAYUSED,0
            SAVEVALUE CURDAY,1
            TERMINATE

NEW\PYGZus{}ALL     GENERATE 0,0,0,NSTUD
            ASSIGN 1,1
            ASSIGN 2,0
            TRANSFER ,WAIT\PYGZus{}SLOT

WAIT\PYGZus{}SLOT   TEST LE X\PYGZdl{}CURDAY,MAXDAY,TIME\PYGZus{}OVER
            TEST L X\PYGZdl{}DAYUSED,DAYCAP,WAIT\PYGZus{}NEXT
            TRANSFER ,ENTER\PYGZus{}EXAM

WAIT\PYGZus{}NEXT   ADVANCE 0.01
            TRANSFER ,WAIT\PYGZus{}SLOT

ENTER\PYGZus{}EXAM  SAVEVALUE DAYUSED+,1
            TEST E P2,0,NOT\PYGZus{}FIRST

FIRST\PYGZus{}ATT   ASSIGN 2,X\PYGZdl{}CURDAY
            TRANSFER ,ATTEMPT\PYGZus{}1

NOT\PYGZus{}FIRST   TEST E P1,2,CHECK\PYGZus{}ATT\PYGZus{}3
            TRANSFER ,ATTEMPT\PYGZus{}2

CHECK\PYGZus{}ATT\PYGZus{}3 TEST E P1,3,BAD\PYGZus{}ATTEMPT
            TRANSFER ,ATTEMPT\PYGZus{}3

BAD\PYGZus{}ATTEMPT TERMINATE

ATTEMPT\PYGZus{}1   TRANSFER 0.6,FAILED\PYGZus{}1,PASSED\PYGZus{}OK
ATTEMPT\PYGZus{}2   TRANSFER 0.25,FAILED\PYGZus{}2,PASSED\PYGZus{}OK
ATTEMPT\PYGZus{}3   TRANSFER 0.1,FINAL\PYGZus{}FAIL,PASSED\PYGZus{}OK

PASSED\PYGZus{}OK   SAVEVALUE PASSED+,1
            TERMINATE

FAILED\PYGZus{}1    TEST L X\PYGZdl{}CURDAY,MAXDAY,NO\PYGZus{}RETRY\PYGZus{}2
            ASSIGN 1,2
            ADVANCE 1.01
            TRANSFER ,WAIT\PYGZus{}SLOT

NO\PYGZus{}RETRY\PYGZus{}2  TERMINATE

FAILED\PYGZus{}2    TEST L X\PYGZdl{}CURDAY,MAXDAY,NO\PYGZus{}RETRY\PYGZus{}3
            ASSIGN 1,3
            ADVANCE 1.01
            TRANSFER ,WAIT\PYGZus{}SLOT

NO\PYGZus{}RETRY\PYGZus{}3  TERMINATE

FINAL\PYGZus{}FAIL  TERMINATE
TIME\PYGZus{}OVER   TERMINATE

DAY\PYGZus{}START   GENERATE 1,0,1,5
            SAVEVALUE DAYUSED,0
            SAVEVALUE CURDAY+,1
            TERMINATE

END\PYGZus{}SIM     GENERATE 0,0,MAXDAY,1
            TERMINATE 1
\end{MintedVerbatim}
