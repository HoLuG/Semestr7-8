*$FROM LibraryEx
$EXTERN LoadFile, Inc, Map, MapAccum;

$ENTRY TokName {
  TkName = 'identifier';

  TkCompound = 'compound symbol';

  TkMacroDigit = 'number';

  TkChar = 'character';

  TkVariable = 'variable';

  TkOpenBracket = '\'(\'';

  TkCloseBracket = '\')\'';

  TkOpenBlock = '\'{\'';

  TkCloseBlock = '\'}\'';

  TkOpenCall = '\'<\'';

  TkCloseCall = '\'>\'';

  TkComma = '\',\'';

  TkColon = '\':\'';

  TkAssign = '\'=\'';

  TkSemicolon = '\';\'';

  TkExtern = '$EXTERN';

  TkEntry = '$ENTRY';

  TkSpecComment = '\'*$\'-comment';

  TkEOF = 'end of file';
}

$ENTRY Builtins {
   = ('+') ('-') ('*') ('/') ('%') ('?') <DoBuiltins <ListOfBuiltin>>;
}

DoBuiltins {
  (s.Number s.Name s.Type) e.Builtins
    = (<Explode s.Name>) <DoBuiltins e.Builtins>;

   = ;
}

$ENTRY Scan {
  e.FileName = <DoScan (1 1 e.FileName) <SkipBOM <LoadFile e.FileName>>>;
}

$ENTRY ScanString-FromPos {
  t.Pos e.String = <DoScan t.Pos (e.String)>;
}

SkipBOM {
  ('ï»¿' e.FirstLine) e.Lines = (e.FirstLine) e.Lines;

  (s.BOM e.FirstLine) e.Lines
    = <SkipBOM_check s.BOM (e.FirstLine) (e.Lines) <Ord s.BOM>>;

  e.Other = <SkipBOM_cont e.Other>;
}

SkipBOM_check {
  s.BOM (e.FirstLine) (e.Lines) 65279 = (e.FirstLine) e.Lines;

  s.BOM (e.FirstLine) (e.Lines) e.Other
    = <SkipBOM_cont (s.BOM e.FirstLine) e.Lines>;
}

SkipBOM_cont {
  e.Lines = e.Lines;
}

IncLine {
  (s.Line s.Col e.FileName) = (<Inc s.Line> 1 e.FileName);
}

IncCol {
  (s.Line s.Col e.FileName) = (s.Line <Inc s.Col> e.FileName);

  t.Pos Len = t.Pos;

  t.Pos Len s.First e.String = <IncCol <IncCol t.Pos> Len e.String>;

  (s.Line s.Col e.FileName) '+' s.Number
    = (s.Line <+ s.Col s.Number> e.FileName);
}

DoScan {
  t.Pos = (TkEOF t.Pos);

  t.Pos () e.Lines = <DoScan <IncLine t.Pos> e.Lines>;

  t.Pos (' ' e.Line) e.Lines = <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos ('\t' e.Line) e.Lines = <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos ('\r' e.Line) e.Lines = <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos ('$' e.Line) e.Lines = <DoScan-Keyword t.Pos (e.Line) e.Lines>;

  t.Pos (s.Digit e.Line) e.Lines
    = <DoScan_check t.Pos s.Digit (e.Line) (e.Lines) <Type s.Digit>>;

  e.Other = <DoScan_cont e.Other>;
}

DoScan_check {
  t.Pos s.Digit (e.Line) (e.Lines) 'D0' s.Digit
    = <DoScan-Number t.Pos t.Pos (s.Digit) (e.Line) e.Lines>;

  t.Pos s.Digit (e.Line) (e.Lines) e.Other
    = <DoScan_cont t.Pos (s.Digit e.Line) e.Lines>;
}

DoScan_cont {
  t.Pos (s.Var '.' e.Line) e.Lines
    = <DoScan_check0 t.Pos s.Var (e.Line) (e.Lines) <IsVarType s.Var>>;

  e.Other = <DoScan_cont0 e.Other>;
}

DoScan_check0 {
  t.Pos s.Var (e.Line) (e.Lines) True
    = <DoScan-Var t.Pos (s.Var '.') (e.Line) e.Lines>;

  t.Pos s.Var (e.Line) (e.Lines) e.Other
    = <DoScan_cont0 t.Pos (s.Var '.' e.Line) e.Lines>;
}

DoScan_cont0 {
  t.Pos ('/*' e.Line) e.Lines
    = <DoScan-CComment t.Pos ('/*') (e.Line) e.Lines>;

  (s.Line 1 e.FileName) ('*$' e.Line) e.Lines
    = (TkSpecComment (s.Line 1 e.FileName) '*$' e.Line)
      <DoScan (<Inc s.Line> 1 e.FileName) e.Lines>;

  (s.Line 1 e.FileName) ('*' e.Comment) e.Lines
    = <DoScan (<Inc s.Line> 1 e.FileName) e.Lines>;

  t.Pos (s.StartIdent e.Line) e.Lines
    = <DoScan_check1 t.Pos s.StartIdent (e.Line) (e.Lines) <Type s.StartIdent>>;

  e.Other = <DoScan_cont1 e.Other>;
}

DoScan_check1 {
  t.Pos s.StartIdent (e.Line) (e.Lines) 'L' s.Case s.StartIdent
    = <DoScan-Ident t.Pos (s.StartIdent) (e.Line) e.Lines>;

  t.Pos s.StartIdent (e.Line) (e.Lines) e.Other
    = <DoScan_cont1 t.Pos (s.StartIdent e.Line) e.Lines>;
}

DoScan_cont1 {
  t.Pos (s.Punctuation e.Line) e.Lines
    = <DoScan_check2
        t.Pos s.Punctuation (e.Line) (e.Lines) <IsPunctuation s.Punctuation>
      >;

  e.Other = <DoScan_cont2 e.Other>;
}

DoScan_check2 {
  t.Pos s.Punctuation (e.Line) (e.Lines) s.TokType
    = (s.TokType t.Pos) <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos s.Punctuation (e.Line) (e.Lines) e.Other
    = <DoScan_cont2 t.Pos (s.Punctuation e.Line) e.Lines>;
}

DoScan_cont2 {
  t.Pos ('<' s.StartIdent e.Line) e.Lines
    = <DoScan_check3 t.Pos s.StartIdent (e.Line) (e.Lines) <Type s.StartIdent>>;

  e.Other = <DoScan_cont3 e.Other>;
}

DoScan_check3 {
  t.Pos s.StartIdent (e.Line) (e.Lines) 'L' s.Case s.StartIdent
    = <DoScan-Ident t.Pos ('<' s.StartIdent) (e.Line) e.Lines>;

  t.Pos s.StartIdent (e.Line) (e.Lines) e.Other
    = <DoScan_cont3 t.Pos ('<' s.StartIdent e.Line) e.Lines>;
}

DoScan_cont3 {
  t.Pos ('<' s.Arithm e.Line) e.Lines
    = <DoScan_check4 t.Pos s.Arithm (e.Line) (e.Lines) '+-*/%?'>;

  e.Other = <DoScan_cont4 e.Other>;
}

DoScan_check4 {
  t.Pos s.Arithm (e.Line) (e.Lines) e.Arithms-B s.Arithm e.Arithms-E
    = (TkOpenCall t.Pos s.Arithm)
      <DoScan <IncCol t.Pos Len '<' s.Arithm> (e.Line) e.Lines>;

  t.Pos s.Arithm (e.Line) (e.Lines) e.Other
    = <DoScan_cont4 t.Pos ('<' s.Arithm e.Line) e.Lines>;
}

DoScan_cont4 {
  t.Pos ('<' e.Line) e.Lines
    = (TkError t.Pos 'Identifier expected after \'<\'')
      <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos ('\'' e.Line) e.Lines = <DoScan-Chars <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos ('\"' e.Line) e.Lines
    = <DoScan-Compound t.Pos <IncCol t.Pos> () (e.Line) e.Lines>;

  t.Pos ('\\' e.Line) e.Lines
    = <DoScan-Escape t.Pos <Escape <IncCol t.Pos> e.Line> e.Lines>;

  t.Pos (s.Other e.Line) e.Lines
    = (TkError t.Pos 'Bad character \'' s.Other '\'')
      <DoScan <IncCol t.Pos> (e.Line) e.Lines>;
}

IsVarType {
  's' = True;

  't' = True;

  'e' = True;

  s.Other = False;
}

IsPunctuation {
  s.Punct
    = <IsPunctuation_check
        s.Punct ('(' TkOpenBracket) (')' TkCloseBracket) ('{' TkOpenBlock)
        ('}' TkCloseBlock) ('>' TkCloseCall) (',' TkComma) (':' TkColon)
        ('=' TkAssign) (';' TkSemicolon)
      >;

  e.Other = <IsPunctuation_cont e.Other>;
}

IsPunctuation_check {
  s.Punct e.Types-B (s.Punct s.TokType) e.Types-E = s.TokType;

  s.Punct e.Other = <IsPunctuation_cont s.Punct>;
}

IsPunctuation_cont {
  s.Other = ;
}

DoScan-Keyword {
  t.Pos (e.Line) e.Lines = <DoScan-BuildKeyword t.Pos ('$') (e.Line) e.Lines>;
}

DoScan-BuildKeyword {
  t.Pos (e.KeywordChars) (s.Next e.Line) e.Lines
    = <DoScan-BuildKeyword_check
        t.Pos (e.KeywordChars) s.Next (e.Line) (e.Lines) <Type s.Next>
      >;

  e.Other = <DoScan-BuildKeyword_cont e.Other>;
}

DoScan-BuildKeyword_check {
  t.Pos (e.KeywordChars) s.Next (e.Line) (e.Lines) 'L' s.SubType s.Next
    = <DoScan-BuildKeyword t.Pos (e.KeywordChars s.Next) (e.Line) e.Lines>;

  t.Pos (e.KeywordChars) s.Next (e.Line) (e.Lines) e.Other
    = <DoScan-BuildKeyword_cont t.Pos (e.KeywordChars) (s.Next e.Line) e.Lines>;
}

DoScan-BuildKeyword_cont {
  t.Pos (e.KeywordChars) (e.Line) e.Lines
    = <DoScan-BuildKeyword_check0
        t.Pos (e.KeywordChars) (e.Line) (e.Lines) (TkExtern '$EXTERN')
        (TkExtern '$EXTRN') (TkExtern '$EXTERNAL') (TkEntry '$ENTRY')
      >;

  e.Other = <DoScan-BuildKeyword_cont0 e.Other>;
}

DoScan-BuildKeyword_check0 {
  t.Pos (e.KeywordChars) (e.Line) (e.Lines) e.Keywords-B (s.Tag e.KeywordChars)
  e.Keywords-E
    = (s.Tag t.Pos) <DoScan <IncCol t.Pos Len e.KeywordChars> (e.Line) e.Lines>;

  t.Pos (e.KeywordChars) (e.Line) (e.Lines) e.Other
    = <DoScan-BuildKeyword_cont0 t.Pos (e.KeywordChars) (e.Line) e.Lines>;
}

DoScan-BuildKeyword_cont0 {
  t.Pos (e.KeywordChars) (e.Line) e.Lines
    = (TkError t.Pos 'Bad keyword \'' e.KeywordChars '\'')
      <DoScan <IncCol t.Pos Len e.KeywordChars> (e.Line) e.Lines>;
}

DoScan-Number {
  t.Pos t.Start (e.Number) (s.Next e.Line) e.Lines
    = <DoScan-Number_check
        t.Pos t.Start (e.Number) s.Next (e.Line) (e.Lines) <Type s.Next>
      >;

  e.Other = <DoScan-Number_cont e.Other>;
}

DoScan-Number_check {
  t.Pos t.Start (e.Number) s.Next (e.Line) (e.Lines) 'D0' s.Next
    = <DoScan-Number
        <IncCol t.Pos> t.Start (<DropZero e.Number> s.Next) (e.Line) e.Lines
      >;

  t.Pos t.Start (e.Number) s.Next (e.Line) (e.Lines) e.Other
    = <DoScan-Number_cont t.Pos t.Start (e.Number) (s.Next e.Line) e.Lines>;
}

DoScan-Number_cont {
  t.Pos t.Start (e.Number) (e.Line) e.Lines
    = <CheckNumber t.Start e.Number> <DoScan t.Pos (e.Line) e.Lines>;
}

DropZero {
  '0' = ;

  e.Number = e.Number;
}

CheckNumber {
  t.Pos e.Number = <CheckNumber0 t.Pos (e.Number) <DoCheckNumber 0 e.Number>>;
}

CheckNumber0 {
  t.Pos (e.Number) Ok s.Value = (TkMacroDigit t.Pos s.Value);

  t.Pos (e.Number) Overflow
    = (TkError t.Pos 'Very big numeric literal: ' e.Number);
}

DoCheckNumber {
  s.Value = Ok s.Value;

  s.Value s.Digit e.Digits
    = <DoCheckNumber0
        s.Value s.Digit (e.Digits) <CheckNumber-AppendDigit s.Value s.Digit>
      >;
}

DoCheckNumber0 {
  s.Value s.Digit (e.Digits) Ok s.NewValue
    = <DoCheckNumber s.NewValue e.Digits>;

  s.Value s.Digit (e.Digits) Overflow = Overflow;
}

CheckNumber-AppendDigit {
  s.Value s.Digit
    = <CheckNumber-AppendDigit_check s.Value s.Digit <Numb s.Digit>>;

  e.Other = <CheckNumber-AppendDigit_cont e.Other>;
}

CheckNumber-AppendDigit_check {
  s.Value s.Digit s.DigitValue
    = <CheckNumber-AppendDigit_check0
        s.Value s.Digit s.DigitValue <* s.Value 10>
      >;

  e.Other = <CheckNumber-AppendDigit_cont0 e.Other>;
}

CheckNumber-AppendDigit_cont {
  s.Value s.Digit = Overflow;
}

CheckNumber-AppendDigit_check0 {
  s.Value s.Digit s.DigitValue s.Value10
    = <CheckNumber-AppendDigit_check1
        s.Value s.Digit s.DigitValue s.Value10 <+ s.Value10 s.DigitValue>
      >;

  e.Other = <CheckNumber-AppendDigit_cont1 e.Other>;
}

CheckNumber-AppendDigit_cont0 {
  s.Value s.Digit e.Other = <CheckNumber-AppendDigit_cont s.Value s.Digit>;
}

CheckNumber-AppendDigit_check1 {
  s.Value s.Digit s.DigitValue s.Value10 s.NewValue
    = <CheckNumber-AppendDigit_check2
        s.Value s.Digit s.DigitValue s.Value10 s.NewValue
        <Divmod s.NewValue 10>
      >;

  e.Other = <CheckNumber-AppendDigit_cont2 e.Other>;
}

CheckNumber-AppendDigit_cont1 {
  s.Value s.Digit s.DigitValue e.Other
    = <CheckNumber-AppendDigit_cont0 s.Value s.Digit s.DigitValue>;
}

CheckNumber-AppendDigit_check2 {
  s.Value s.Digit s.DigitValue s.Value10 s.NewValue (s.Value) s.DigitValue
    = Ok s.NewValue;

  s.Value s.Digit s.DigitValue s.Value10 s.NewValue e.Other
    = <CheckNumber-AppendDigit_cont2
        s.Value s.Digit s.DigitValue s.Value10 s.NewValue
      >;
}

CheckNumber-AppendDigit_cont2 {
  s.Value s.Digit s.DigitValue s.Value10 e.Other
    = <CheckNumber-AppendDigit_cont1 s.Value s.Digit s.DigitValue s.Value10>;
}

DoScan-Var {
  t.Pos (e.Variable) (s.Next e.Line) e.Lines
    = <DoScan-Var_check
        t.Pos (e.Variable) s.Next (e.Line) (e.Lines) <IsIdentTail s.Next>
      >;

  e.Other = <DoScan-Var_cont e.Other>;
}

DoScan-Var_check {
  t.Pos (e.Variable) s.Next (e.Line) (e.Lines) True
    = <DoScan-Var t.Pos (e.Variable s.Next) (e.Line) e.Lines>;

  t.Pos (e.Variable) s.Next (e.Line) (e.Lines) e.Other
    = <DoScan-Var_cont t.Pos (e.Variable) (s.Next e.Line) e.Lines>;
}

DoScan-Var_cont {
  t.Pos (s.Type '.' e.Index) (e.Line) e.Lines
    = (TkVariable t.Pos s.Type e.Index) <CheckIndex t.Pos e.Index>
      <DoScan <IncCol t.Pos Len s.Type '.' e.Index> (e.Line) e.Lines>;
}

IsIdentTail {
  '-' = True;

  '_' = True;

  s.Other = <IsIdentTail0 s.Other <Type s.Other>>;
}

IsIdentTail0 {
  s.Other 'D0' s.Other = True;

  s.Other 'L' s.Case s.Other = True;

  s.Other e.OtherType = False;
}

CheckIndex {
  t.Pos s.Digit e.MustBeDigits
    = <CheckIndex_check t.Pos s.Digit (e.MustBeDigits) <Type s.Digit>>;

  e.Other = <CheckIndex_cont e.Other>;
}

CheckIndex_check {
  t.Pos s.Digit (e.MustBeDigits) 'D0' s.Digit_
    = <CheckIndex-Digits t.Pos e.MustBeDigits>;

  t.Pos s.Digit (e.MustBeDigits) e.Other
    = <CheckIndex_cont t.Pos s.Digit e.MustBeDigits>;
}

CheckIndex_cont {
  t.Pos s.Letter e.Any
    = <CheckIndex_check0 t.Pos s.Letter (e.Any) <Type s.Letter>>;

  e.Other = <CheckIndex_cont0 e.Other>;
}

CheckIndex_check0 {
  t.Pos s.Letter (e.Any) 'L' s.st s.Letter_ = ;

  t.Pos s.Letter (e.Any) e.Other = <CheckIndex_cont0 t.Pos s.Letter e.Any>;
}

CheckIndex_cont0 {
  t.Pos s.Other e.Any
    = (TkError t.Pos 'index must start with a letter or a number');

  t.Pos = (TkError t.Pos 'empty variable index');
}

CheckIndex-Digits {
  t.Pos = ;

  t.Pos s.Digit e.MustBeDigits
    = <CheckIndex-Digits_check t.Pos s.Digit (e.MustBeDigits) <Type s.Digit>>;

  e.Other = <CheckIndex-Digits_cont e.Other>;
}

CheckIndex-Digits_check {
  t.Pos s.Digit (e.MustBeDigits) 'D0' s.Digit_
    = <CheckIndex-Digits t.Pos e.MustBeDigits>;

  t.Pos s.Digit (e.MustBeDigits) e.Other
    = <CheckIndex-Digits_cont t.Pos s.Digit e.MustBeDigits>;
}

CheckIndex-Digits_cont {
  t.Pos s.Unexpected e.Tail = (TkError t.Pos 'index must be whole number');
}

DoScan-CComment {
  t.Pos (e.Comment) ('*/' e.Line) e.Lines
    = <DoScan <IncCol t.Pos Len e.Comment '*/'> (e.Line) e.Lines>;

  t.Pos (e.Comment) (s.Char e.Line) e.Lines
    = <DoScan-CComment t.Pos (e.Comment s.Char) (e.Line) e.Lines>;

  t.Pos (e.Comment) () e.Lines = <DoScan-CComment <IncLine t.Pos> () e.Lines>;

  t.Pos (e.Comment)
    = (TkError t.Pos 'Unexpected EOF, unclosed comment')
      (TkEOF <IncCol t.Pos Len e.Comment>);
}

DoScan-Ident {
  t.Pos (e.Ident) (s.Next e.Line) e.Lines
    = <DoScan-Ident_check
        t.Pos (e.Ident) s.Next (e.Line) (e.Lines) <IsIdentTail s.Next>
      >;

  e.Other = <DoScan-Ident_cont e.Other>;
}

DoScan-Ident_check {
  t.Pos (e.Ident) s.Next (e.Line) (e.Lines) True
    = <DoScan-Ident t.Pos (e.Ident s.Next) (e.Line) e.Lines>;

  t.Pos (e.Ident) s.Next (e.Line) (e.Lines) e.Other
    = <DoScan-Ident_cont t.Pos (e.Ident) (s.Next e.Line) e.Lines>;
}

DoScan-Ident_cont {
  t.Pos ('<' e.Ident) (e.Line) e.Lines
    = (TkOpenCall t.Pos e.Ident)
      <DoScan <IncCol t.Pos Len '<' e.Ident> (e.Line) e.Lines>;

  t.Pos (e.Ident) (e.Line) e.Lines
    = (TkName t.Pos e.Ident)
      <DoScan <IncCol t.Pos Len e.Ident> (e.Line) e.Lines>;
}

DoScan-Chars {
  t.Pos ('\\' e.Line) e.Lines
    = <DoScan-Chars-Escape t.Pos <Escape <IncCol t.Pos> e.Line> e.Lines>;

  t.Pos ('\'' e.Line) e.Lines = <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos (s.Char e.Line) e.Lines
    = (TkChar t.Pos s.Char) <DoScan-Chars <IncCol t.Pos> (e.Line) e.Lines>;

  t.Pos () e.Lines
    = (TkError t.Pos 'Unclosed \' - single quote')
      <DoScan <IncLine t.Pos> e.Lines>;
}

Escape {
  t.Pos s.Escaped e.Line
    = <Escape_check
        t.Pos s.Escaped (e.Line) ('\'\'') ('\"\"') ('\\\\') ('n\n') ('r\r')
        ('t\t') ('<<') ('>>') ('((') ('))')
      >;

  e.Other = <Escape_cont e.Other>;
}

Escape_check {
  t.Pos s.Escaped (e.Line) e.Escapes-B (s.Escaped s.Char) e.Escapes-E
    = Ok s.Char <IncCol t.Pos> (e.Line);

  t.Pos s.Escaped (e.Line) e.Other = <Escape_cont t.Pos s.Escaped e.Line>;
}

Escape_cont {
  t.Pos 'x' s.Hex1 s.Hex2 e.Line
    = <Escape_check0 t.Pos s.Hex1 s.Hex2 (e.Line) <HexDigit s.Hex1>>;

  e.Other = <Escape_cont0 e.Other>;
}

Escape_check0 {
  t.Pos s.Hex1 s.Hex2 (e.Line) s.Num1
    = <Escape_check1 t.Pos s.Hex1 s.Hex2 (e.Line) s.Num1 <HexDigit s.Hex2>>;

  e.Other = <Escape_cont1 e.Other>;
}

Escape_cont0 {
  t.Pos 'x' e.Line
    = Error ('After \\x must be two hex digits') <IncCol t.Pos> (e.Line);

  t.Pos s.Other e.Line
    = Error ('Bad escape sequence \\' s.Other) <IncCol t.Pos> (e.Line);

  t.Pos = Error-EOL;
}

Escape_check1 {
  t.Pos s.Hex1 s.Hex2 (e.Line) s.Num1 s.Num2
    = Ok <Chr <+ <* s.Num1 16> s.Num2>> <IncCol t.Pos Len 'x' s.Hex1 s.Hex2>
      (e.Line);

  t.Pos s.Hex1 s.Hex2 (e.Line) s.Num1 e.Other
    = <Escape_cont1 t.Pos s.Hex1 s.Hex2 (e.Line) s.Num1>;
}

Escape_cont1 {
  t.Pos s.Hex1 s.Hex2 (e.Line) e.Other
    = <Escape_cont0 t.Pos 'x' s.Hex1 s.Hex2 e.Line>;
}

DoScan-Chars-Escape {
  t.Pos Ok s.Char t.NextPos (e.Line) e.Lines
    = (TkChar t.Pos s.Char) <DoScan-Chars t.NextPos (e.Line) e.Lines>;

  t.Pos Error (e.Message) t.NextPos (e.Line) e.Lines
    = (TkError t.Pos e.Message) <DoScan-Chars t.NextPos (e.Line) e.Lines>;

  t.Pos Error-EOL e.Lines
    = (TkError t.Pos 'Unexpected \\ at end of string literal')
      <DoScan <IncLine t.Pos> e.Lines>;
}

HexDigit {
  s.Digit = <HexDigit0 s.Digit <Type s.Digit>>;
}

HexDigit0 {
  s.Digit 'D0' s.Digit = <Numb s.Digit>;

  s.Digit 'Lu' s.Digit = <DoHexDigit 'ABCDEF' 10 s.Digit>;

  s.Digit 'Ll' s.Digit = <DoHexDigit 'abcdef' 10 s.Digit>;

  s.Digit s.OtherType s.OtherSubtype s.OtherChar = ;
}

DoHexDigit {
  s.Digit e.Samples s.Val s.Digit = s.Val;

  s.OtherDigit e.Samples s.Val s.Digit
    = <DoHexDigit e.Samples <Inc s.Val> s.Digit>;

  s.BadVal s.Digit = ;
}

DoScan-Compound {
  t.StartPos t.Pos (e.Compound) ('\"' e.Line) e.Lines
    = (TkCompound t.StartPos e.Compound)
      <DoScan <IncCol t.Pos> (e.Line) e.Lines>;

  t.StartPos t.Pos (e.Compound) ('\\' e.Line) e.Lines
    = <DoScan-Compound-HandleEscape
        t.StartPos t.Pos (e.Compound) <Escape <IncCol t.Pos> e.Line> e.Lines
      >;

  t.StartPos t.Pos (e.Compound) (s.Char e.Line) e.Lines
    = <DoScan-Compound
        t.StartPos <IncCol t.Pos> (e.Compound s.Char) (e.Line) e.Lines
      >;

  t.StartPos t.Pos (e.Compound) () e.Lines
    = (TkError t.Pos 'Unclosed \" - double quote')
      <DoScan <IncLine t.Pos> e.Lines>;
}

DoScan-Compound-HandleEscape {
  t.StartPos t.EscapePos (e.Compound) Ok s.Char t.NextPos (e.Line) e.Lines
    = <DoScan-Compound
        t.StartPos t.NextPos (e.Compound s.Char) (e.Line) e.Lines
      >;

  t.StartPos t.EscapePos (e.Compound) Error (e.Message) t.NextPos (e.Line)
  e.Lines
    = (TkError t.EscapePos e.Message)
      <DoScan-Compound t.StartPos t.NextPos (e.Compound) (e.Line) e.Lines>;

