  t.Pos Error (e.Message) t.NextPos (e.Line) e.Lines
    = (TkError t.Pos e.Message) <DoScan t.NextPos (e.Line) e.Lines>;

  t.Pos Error-EOL e.Lines
    = (TkError t.Pos 'Unexpected \\ at end of line')
      <DoScan <IncLine t.Pos> e.Lines>;
}

$ENTRY Parse {
  t.First e.Tokens = <Parse_check t.First (e.Tokens) t.First>;
}

Parse_check {
