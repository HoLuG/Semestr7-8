* В нераскрученной версии нельзя использовать литералы из произвольного
* количества цифр, поэтому для совместимости с парсером длинные числа
* придётся разбивать на группы по три цифры

$ENTRY Go {
  /* пусто */
    = <Eq <+ 100 200>                    (300)>
      <Eq <+ (100) 200>                  (300)>
      <Eq <+ '+' 100 200>                (300)>
      <Eq <+ '+' 100 '+' 200>            (300)>
      <Eq <+ ('+' 100) 200>              (300)>
      <Eq <+ ('+' 100) '+' 200>          (300)>
      <Eq <+ (0 0 100) 0 0 200>          (300)>
      <Eq <+ ('+' 0 0 100) '+' 0 0 200>  (300)>
      <Eq <- 100 '-' 200>                (300)>
      <Eq <- '-' 100 200>                ('-' 300)>

      <Eq <- 800 300>                    (500)>
      <Eq <+ '-' 800 300>                ('-' 500)>
      <Eq <+ 800 '-' 300>                (500)>
      <Eq <+ '-' 800 300>                ('-' 500)>
      <Eq <- '-' 800 '-' 300>            ('-' 500)>
      <Eq <- 800 0 0 0 0 300>            (500)>

      <Eq <+ '-' 0 '-' 0>                (0)>
      <Eq <+ '+' 0 '-' 0>                (0)>
      <Eq <+ '-' 0 '+' 0>                (0)>
      <Eq <+ '+' 0 '+' 0>                (0)>

      <Eq <- '-' 0 '-' 0>                (0)>
      <Eq <- '+' 0 '-' 0>                (0)>
      <Eq <- '-' 0 '+' 0>                (0)>
      <Eq <- '+' 0 '+' 0>                (0)>

      <Eq <- 10 10>                      (0)>
      <Eq <- '-' 10 '-' 10>              (0)>

      <Eq <* 20 30>                      (600)>
      <Eq <* 20 0 0 0 30>                (600)>
      <Eq <* '+' 20 '+' 30>              (600)>
      <Eq <* ('+' 0 0 20) '+' 0 0 30>    (600)>
      <Eq <* '-' 20 '-' 30>              (600)>
      <Eq <* '+' 20 '-' 30>              ('-' 600)>
      <Eq <* '-' 20 '+' 30>              ('-' 600)>
      <Eq <* '-' 10 0>                   (0)>
      <Eq <* 0 '-' 10>                   (0)>

      <Eq <Divmod 1000 77>               ((12) 76)>
      <Eq <Divmod '-' 1000 77>           (('-' 12) '-' 76)>
      <Eq <Divmod 1000 '-' 77>           (('-' 12) 76)>
      <Eq <Divmod '-' 1000 '-' 77>       ((12) '-' 76)>

      <Eq </ 1000 77>                    (12)>
      <Eq </ '-' 1000 77>                ('-' 12)>
      <Eq </ 1000 '-' 77>                ('-' 12)>
      <Eq </ '-' 1000 '-' 77>            (12)>

      <Eq <% 1000 77>                    (76)>
      <Eq <% '-' 1000 77>                ('-' 76)>
      <Eq <% 1000 '-' 77>                (76)>
      <Eq <% '-' 1000 '-' 77>            ('-' 76)>

      <Eq <Compare 100 500>              ('-')>
      <Eq <Compare '+' 100 '+' 500>      ('-')>
      <Eq <Compare '-' 100 500>          ('-')>
      <Eq <Compare '-' 100 '+' 500>      ('-')>
      <Eq <Compare 100 '-' 500>          ('+')>
      <Eq <Compare '+' 100 '-' 500>      ('+')>
      <Eq <Compare '-' 100 '-' 500>      ('+')>
      <Eq <Compare 500 100>              ('+')>
      <Eq <Compare '-' 500 100>          ('-')>
      <Eq <Compare 500 '-' 100>          ('+')>
      <Eq <Compare 100 100>              ('0')>
      <Eq <Compare '+' 0 '-' 0>          ('0')>
      <Eq <Compare '-' 0 '+' 0>          ('0')>
      <Eq <Compare '-' 0 '-' 0>          ('0')>
      <Eq <Compare '+' 0 '+' 0>          ('0')>
      <Eq <Compare 100 '+' 100>          ('0')>
      <Eq <Compare (1 2 3) 4 5>          ('+')>
      <Eq <Compare (4 5) 1 2 3>          ('-')>
      <Eq <Compare (1 2 3) 1 2 2>        ('+')>
      <Eq <Compare (1 2 3) 1 2 4>        ('-')>
      <Eq <Compare (1 2 3) 1 2 3>        ('0')>

      <Eq
        <Divmod (<Numb1000 6 6 6 6 6 6>) <Numb1000 2 2>>
        ((<Numb1000 3 0 3 0 3>) 0)
      >
      <Eq
        </ (<Numb1000 6 6 6 6 6 6 6>) <Numb1000 2 2>>
        (<Numb1000 3 0 3 0 3 0>)
      >
      <Eq <% (<Numb1000 6 6 6 6 6 6>) <Numb1000 2 2>> (0)>
      <Eq
        <Divmod (<Numb1000 6 6 6 6 6 6 6>) <Numb1000 2 2 2>>
        ((<Numb1000 3 0 0 3 0>) 6)
      >
      <Eq
        </ (<Numb1000 6 6 6 6 6 6 6>) <Numb1000 2 2 2>>
        (<Numb1000 3 0 0 3 0>)
      >
      <Eq <% (<Numb1000 6 6 6 6 6 6 6>) <Numb1000 2 2 2>> (6)>
      <Eq
        <Divmod (<Numb1000 6 6 6 6 6 6 6 6>) <Numb1000 2 2 2>>
        ((<Numb1000 3 0 0 3 0 0>) <Numb1000 6 6>)
      >
      <Eq
        </ (<Numb1000 6 6 6 6 6 6 6 6>) <Numb1000 2 2 2>>
        (<Numb1000 3 0 0 3 0 0>)
      >
      <Eq <% (<Numb1000 6 6 6 6 6 6 6 6>) <Numb1000 2 2 2>> (<Numb1000 6 6>)>

      <Eq <Numb '0'>                     (0)>
      <Eq <Numb '+0'>                    (0)>
      <Eq <Numb '-0'>                    (0)>
      <Eq <Numb '100500'>                (100500)>
      <Eq <Numb '+100500'>               (100500)>
      <Eq <Numb '-100500'>               ('-' 100500)>
      <Eq <Numb '     0'>                (0)>
      <Eq <Numb '     +0'>               (0)>
      <Eq <Numb '     -0'>               (0)>
      <Eq <Numb '     100500'>           (100500)>
      <Eq <Numb '     +100500'>          (100500)>
      <Eq <Numb '     -100500'>          ('-' 100500)>
      <Eq <Numb ' \t  0'>                (0)>
      <Eq <Numb ' \t\t+0'>               (0)>
      <Eq <Numb '\t\t -0'>               (0)>
      <Eq <Numb '\t \t100500'>           (100500)>
      <Eq <Numb '\t\t +100500'>          (100500)>
      <Eq <Numb '\t \t-100500'>          ('-' 100500)>
      <Eq <Numb '100500abcd'>            (100500)>
      <Eq <Numb '+100500' 1 2 3 4>       (100500)>
      <Eq <Numb '-100500' A B C D>       ('-' 100500)>
      <Eq <Numb '100500' () () ()>       (100500)>
      <Eq <Numb '4294967295'>            (4294967295)>
      <Eq <Numb 'not a number'>          (0)>
      <Eq <Numb not a number>            (0)>
      <Eq <Numb 100500>                  (0)>
      <Eq <Numb>                         (0)>

      <Eq
        <Numb '1' '000' '000' '000' '000' '000'>
        (<Numb1000 1 0 0 0 0 0>)
      >
      <Eq
        <Numb '+1' '000' '000' '000' '000' '000'>
        (<Numb1000 1 0 0 0 0 0>)
      >
      <Eq
        <Numb '-1' '000' '000' '000' '000' '000'>
        ('-' <Numb1000 1 0 0 0 0 0>)
      >

      <Eq <Symb 0>                       ('0')>
      <Eq <Symb 1>                       ('1')>
      <Eq <Symb 1234567890>              ('1234567890')>
      <Eq <Symb 4294967295>              ('4294967295')>

      <Eq <Symb '+' 0>                   ('+0')>
      <Eq <Symb '+' 1>                   ('+1')>
      <Eq <Symb '+' 1234567890>          ('+1234567890')>

      <Eq <Symb '-' 0>                   ('-0')>
      <Eq <Symb '-' 1>                   ('-1')>
      <Eq <Symb '-' 1234567890>          ('-1234567890')>

      <Eq <Symb '-' 0 0 0 0 0 123456789> ('-123456789')>

      <Eq
        <Symb 4294967295 4294967295 4294967295>
        ('79228162514264337593543950335')
      >
      <Eq
        <Symb 4294967295 4294967295 4294967295 4294967295>
        ('340282366920938463463374607431768211455')
      >

      <Eq
        <Symb <Numb1000 1 2 3 4 5 6 7 8 9>>
        ('1002003004005006007008009')
      >
      <Eq
        <Symb <Numb1000 1 2 3 4 5 6 7 8 9 1 2 3 4 5 6 7 8 9>>
        ('1002003004005006007008009001002003004005006007008009')
      >
}

Eq { e.X (e.X) = }

Numb1000 {
  s.One = s.One;

  /* проверяем, что промежуточные результаты влезают в одну цифру */
  e.Digits s.Last
    , <Numb1000 e.Digits> : s.High
    , <* s.High 1000> : s.High1000
    , <+ s.High1000 s.Last> : s.Result
    = s.Result;
}
