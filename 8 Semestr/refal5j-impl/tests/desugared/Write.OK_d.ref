$ENTRY Go {
    = <Eq () <Write 0 'Hello, '>> <Eq () <Write 0 'World!'>>
      <Eq () <Open wb 15>>
      <Eq
        ()
        <Write
          15 <Chr 0> '\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0b\x0c\r\x0e\x0f'
          '\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f'
        >
      >
      <Eq () <Close 15>> <Eq (17) <Step>>;
}

Eq {
  (e.X) e.X = <Prout e.X>;
}

