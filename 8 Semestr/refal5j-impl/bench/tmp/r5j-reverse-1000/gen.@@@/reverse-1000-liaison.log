Go :: e = e
  e: /* empty */
    , <Go.RangeUp e: 1 1000> :: e.#1
    , <Go.Reverse e: e.#1> :: e.#2
    = e: e.#2;
    // next index: 3
}

Go.Reverse :: e = e
  e: /* empty */
    = e: /* empty */;
    // next index: 1

  e: s.X e.Rest
    , <Go.Reverse e: e.Rest> :: e.#1
    = e: e.#1 s.X;
    // next index: 2
}

Go.RangeUp :: e = e
  e: s.From s.To
    , <Compare e: s.From s.To> :: e.#1
    , <Go.ConsBy e: e.#1 s.From s.To> :: e.#2
    = e: e.#2;
    // next index: 3
}

Go.ConsBy :: e = e
  e: '+' s.From s.To
    = e: /* empty */;
    // next index: 1

  e: s.Op s.From s.To
    , <Add e: s.From 1> :: e.#1
    , <Go.RangeUp e: e.#1 s.To> :: e.#2
    = e: s.From e.#2;
    // next index: 3
}

Go.Mu :: e = e {
  $METATABLE:
    Go = Go
    Reverse = Go.Reverse
    RangeUp = Go.RangeUp
    ConsBy = Go.ConsBy
    Mu = Go.Mu
    Residue = Go.Residue
    Up = Go.Up
    Ev-met = Go.Ev-met
}

Go.Residue :: e = e {
  $METATABLE => Go.Mu
}

Go.Up :: e = e {
  $METATABLE => Go.Mu
}

Go.Ev-met :: e = e {
  $METATABLE => Go.Mu
}
